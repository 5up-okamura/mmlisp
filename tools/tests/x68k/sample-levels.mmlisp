; x68k PCM8's levels as they move: a track's :vol (a value, a sweep, + and *
; through a sweep), the song's :master swept from an FM track, a note's :vol
; and :vel macros, a :keyon retrigger, a :pitch sweep.
(def-score :target x68k :title "x68k sample levels")
(def-pcm blip :file "wav/blip.wav")
(fm1 :tempo 125 :len 1 c :master (linear 31..12 :len 2/1) c c :master 31 c |)
(pcm1 :len 4 blip :mode loop c :vol (linear 31..8 :len 2/1) c c :vol+ 6 c :vol* 1.5 c
  :mode shot :vol 28 (macro :vol (linear 31..10 :len 20f)) c c
  (macro :vel [15 11 7 3] :keyon [1 0 1 0]) :len 2 c
  :mode loop :pitch (linear 0..-700 :len 1/1) :len 1 c :pitch 0 |)
