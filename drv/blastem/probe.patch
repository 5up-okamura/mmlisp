+// ── MMLispDRV probe (see util.h) ───────────────────────────────────────────
+// Eight bytes a record, little-endian, so that a run of a few minutes is a few
+// megabytes and the reader is four lines of JavaScript. Buffered by stdio and
+// flushed at exit; a run that crashes loses at most a buffer, and a run that
+// crashes has already told you what you needed.
+static FILE *mml_probe_file;
+static int   mml_probe_tried;
+
+void mml_probe_log(uint8_t kind, uint16_t value, uint32_t cycle)
+{
+	if (!mml_probe_tried) {
+		mml_probe_tried = 1;
+		const char *path = getenv("MMLISP_PROBE_LOG");
+		if (path && *path) mml_probe_file = fopen(path, "wb");
+	}
+	if (!mml_probe_file) return;
+	uint8_t rec[8] = {
+		kind, 0, value & 0xFF, value >> 8,
+		cycle & 0xFF, cycle >> 8, cycle >> 16, cycle >> 24
+	};
+	fwrite(rec, 1, sizeof(rec), mml_probe_file);
+}
