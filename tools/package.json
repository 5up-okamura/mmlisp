{
  "name": "mmlisp-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal local tooling for MMLisp draft workflow",
  "scripts": {
    "format:mmlisp": "node scripts/format-mmlisp.js ../presets/*/set.mmlisp",
    "check:format:mmlisp": "node scripts/format-mmlisp.js --check ../presets/*/set.mmlisp",
    "mmlisp2ir": "node scripts/mmlisp2ir.js",
    "verify-ir": "node scripts/verify-ir.js",
    "check:mmlisp-strict": "node scripts/check-mmlisp-strict.js",
    "check:sample-fx": "node scripts/check-sample-fx.mjs",
    "check:cheatsheet": "node scripts/check-cheatsheet.mjs",
    "check:reference": "node scripts/check-reference.mjs",
    "check:i18n": "node scripts/i18n-sync.mjs",
    "mcp": "node mcp/mmlisp-mcp.mjs",
    "check:scope-trigger": "node scripts/check-scope-trigger.mjs",
    "check:snapshot": "node scripts/check-snapshot.mjs",
    "check:resynth": "node scripts/check-resynth.mjs",
    "check:voice-estimate": "node scripts/check-voice-estimate.mjs",
    "check:import-mdx-mgs": "node scripts/check-import-mdx-mgs.mjs",
    "check:import-vgm": "node scripts/check-import-vgm.mjs",
    "check:import-tracker": "node scripts/check-import-tracker.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
