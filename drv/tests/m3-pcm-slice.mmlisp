; M3 gate: one WAV sliced into several samples by :offset / :frames (frames,
; not bytes). This is how an imported instrument bank works — a single file
; every def cuts a region out of — so the gate locks that the node loader
; slices like the browser one instead of embedding the whole bank per def.
; :loop-start / :loop-end are times in the slice, not in the file.
(def-sample hit :file "pad.wav" :offset 0   :frames 128)
(def-sample body :file "pad.wav" :offset 128 :frames 256 :loop-start 2ms :loop-end 18ms)
(def-sample tail :file "pad.wav" :offset 384)
(pcm1 hit  :tempo 120 :oct 4 :len 8 :vel 15  c e g c)
(pcm2 body :mode loop :oct 4 :len 4 :vel 12  c _ e _)
