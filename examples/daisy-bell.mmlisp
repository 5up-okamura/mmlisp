; Daisy Bell, after the 1961 IBM 7094 performance (voice by Kelly and
; Lochbaum, accompaniment by Max Mathews), the first computer to sing. The
; voice is CSM as in the csm-voice snippet: the vowel is four formant MLs over
; a base, the melody is the Timer A rate, and the noise channel adds
; consonants. The three squares play the waltz accompaniment. A syllable is
; one def over the voice's three tracks and a bar of the waltz one over the
; squares, so the song is written as its lyrics and its chords.

(def-fm vox init-fm :alg 7 :fb 0
  :ar1 31 :rr1 13 :tl1 4
  :ar2 31 :rr2 14 :tl2 10
  :ar3 31 :rr3 15 :tl3 18
  :ar4 31 :rr4 15 :tl4 26)

; vowel = base note x ML per operator (formants F1-F4)
(def ah :oct 4 :ml1 2 :ml2 3 :ml3 7  :ml4 9  f+)
(def ee :oct 4 :ml1 1 :ml2 8 :ml3 11 :ml4 13 c+)
(def oo :oct 4 :ml1 1 :ml2 3 :ml3 8  :ml4 11 d)
(def eh :oct 4 :ml1 2 :ml2 7 :ml3 9  :ml4 12 c)
(def oh :oct 4 :ml1 2 :ml2 3 :ml3 9  :ml4 12 c+)

; consonants: a hiss for s, a breath for h and f, clicks for k/t and d/b/g
(def sh :mode white0 (macro :vel [7 9 9 9 8 7 5 3 1 0]) c)
(def hh :mode white0 (macro :vel [6 5 4 2 0]) c)
(def kh :mode white1 (macro :vel [13 8 3 0]) c)
(def gh :mode white1 (macro :vel [8 4 0]) c)

; a syllable: its length, its vowel (swelling in from a lower fader), its
; pitch (a Timer A rate; an octave step goes with it in an empty let) and
; its consonant (_ for none)
(def (sing len vowel pitch cons)
  (fm3-csm :len len :vol (linear 14..31 :len 16) vowel)
  (fm3-csm-rate :len len pitch)
  (noise :len len cons))

(fm3-csm vox :tempo 150)
(fm3-csm-rate :oct 4 (glide 16))                ; glide slides between the rates
(noise)

; Dai-sy, Dai-sy, give me your an-swer, do
(sing 2. ah g gh) (sing 2. ee e sh) (sing 2. ah c gh) (sing 2. ee (let [] < g) sh)
(sing 4 ee a gh) (sing 4 ee b _) (sing 4 oh (let [] > c) _) (sing 2 ah (let [] < a) _)
(sing 4 eh (let [] > c) sh) (sing 1. oo (let [] < g) gh)
; I'm half cra-zy, all for the love of you
(sing 2. ah (let [] > d) _) (sing 2. ah g hh) (sing 2. eh e kh) (sing 2. ee c sh)
(sing 4 oh (let [] < a) _) (sing 4 oh b hh) (sing 4 eh (let [] > c) _) (sing 2 ah d _)
(sing 4 oh e _) (sing 1 oo (let [] d1 ~ d4) _) (fm3-csm :len 4 _) (noise :len 4 _)
; It won't be a sty-lish mar-riage
(sing 4 ee e _) (sing 4 oh f _) (sing 4 ee e gh) (sing 4 ah d _)
(sing 2 ah g sh) (sing 4 ee e _) (sing 4 ah d _) (sing 1 ee c _)
; I can't af-ford a car-riage
(sing 4 ah d _) (sing 2 ah e kh) (sing 4 ah c _) (sing 2 oh (let [] < a) hh)
(sing 4 ah (let [] > c) _) (sing 4 ah (let [] < a) kh) (sing 1 ee g _)
; But you'll look sweet u-pon the seat of a bi-cy-cle built for two
(sing 4 ah g gh) (sing 2 oo (let [] > c) _) (sing 4 oo e _) (sing 2 ee d sh)
(sing 4 oo (let [] < g) _) (sing 2 oh (let [] > c) gh) (sing 4 eh e _) (sing 4 ee d sh)
(sing 4 oh e _) (sing 4 ah f _) (sing 4 ah g gh) (sing 4 ee e sh) (sing 4 oh c kh)
(sing 2 ee d gh) (sing 4 oh (let [] < g) hh) (sing 1. oo (let [] > c) kh)

; waltz accompaniment: a bar is the bass on the downbeat, the chord on two
; and three
(def (waltz bass mid high)
  (sqr3 :oct 3 :len 4 bass _ _)
  (sqr2 :oct 4 :len 4 _ mid mid)
  (sqr1 :oct 4 :len 4 _ high high))
(def C (waltz c e g))
(def F (waltz f f a))
(def G7 (waltz g d f))
(def D7 (waltz d c f+))

(sqr3 :vel 10) (sqr2 :vel 8) (sqr1 :vel 8)
C C F C  F F C G7   G7 G7 C C  D7 G7 G7 G7
G7 C C C  C F C G7  C G7 C G7  C G7 C C
