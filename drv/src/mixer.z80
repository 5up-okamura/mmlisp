mix_addnr_s2:
mix_addnr_s2_lp:
        ex   af,af'            ; A' is the gate phase (1..GROUP); see gatePrologue
        dec  a
        jr   nz,ep125          ; PATCHED: ep125 at unity, ea125 under a shift
        call gate_wait         ; hold for Timer B; returns A = PCM_GROUP
ea125:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ms125:
        jr   ex125             ; master chain, slot 0 — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        jr   ex125               ; …and into the tail the plain copy shares
ep125:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ex125:
        xor  $80               ; the ring is signed, the DAC is not
        ld   (YM_DATA0),a      ; $2A, fed blind
        inc  iy                ; wraps at a SEGMENT boundary, never here
        ld   a,(de)             ; sample
        sra  a
        sra  a
        add  a,(hl)
        jp   pe,ov126
dn127:
        ld   (hl),a
        inc  l
        inc  de                ; pre-resampled: one sample per tick
        ld   a,(de)             ; sample
        sra  a
        sra  a
        add  a,(hl)
        jp   pe,ov128
dn129:
        ld   (hl),a
        inc  l
        inc  de                ; pre-resampled: one sample per tick
        dec  b
        jp   nz,mix_addnr_s2_lp
