; ===========================================================================
; MMLispDRV Z80 engine (docs/driver.md §5, §6)
;
; Post-split, the Z80 no longer sequences anything. Its whole job is:
;   1. take one pre-rendered slot per vblank out of a ring the 68000 fills,
;   2. put its bytes on the YM2612 and the PSG, pacing them itself,
;   3. spend the rest of the frame software-mixing PCM into the fm6 DAC.
;
; It evaluates nothing: every value it writes arrives register-ready, and every
; PCM field arrives pre-computed (increment, volume shift, segment shift). The
; one piece of live state it owns is PCM sample position.
;
; The Z80 keeps the clock — it consumes exactly one slot per interrupt at its
; own 60 Hz, so a heavy game frame eats into the ring's lookahead instead of
; stuttering the music (driver.md §1).
; ===========================================================================

; ── Hardware ───────────────────────────────────────────────────────────────
YM_ADDR0    equ $4000
YM_DATA0    equ $4001
YM_ADDR1    equ $4002
YM_DATA1    equ $4003
BANK_REG    equ $6000
PSG_PORT    equ $7f11
WINDOW      equ $8000

; ── Build constants (driver.md §5.3.1, §6.1) ───────────────────────────────
; Depth 3, not 2, and the reason is §3.5: the sub-slots are read at 1/3 and 2/3
; of the frame, so the slot being consumed stays OURS for the whole frame and
; the 68k must not touch it. One ring slot is therefore always in use, and the
; pending lookahead is depth-2 — at depth 2 that is ZERO and the ring starves
; every other frame (measured: 50%, half-speed music). Depth 3 restores exactly
; the one-slot lookahead the pre-sub-tick engine had at depth 2, at one more
; frame of host->music latency (§3.4).
RING_DEPTH  equ 3               ; slots of lookahead; a per-game knob (§3.4)
SLOT_SIZE   equ 256             ; page-aligned, so a slot address is one byte
SLOT_SHIFT  equ 8               ; log2(SLOT_SIZE); published for the 68k
PCM_VOICES  equ 2
; Sub-slots per slot (driver.md §3.5). Sub-slot 0 goes out at the frame head as
; it always did; the rest ride the mixer's VOICE-PASS BOUNDARIES — so this is
; coupled to PCM_PASSES and is not a free parameter. With three passes the
; boundaries sat at 1/3 and 2/3 and SLOT_SUBS was 3; with two they sit at 1/2,
; and a third sub-slot would have no boundary to ride — pace_sub would have to
; place it by hand, which is dead time the DAC spends holding. Must match the
; 68k's MML_SLOT_SUBS.
SLOT_SUBS   equ 2

; ── RAM map (driver.md §5.2) ───────────────────────────────────────────────
; The engine is small enough that the 8 KB stops being a design input: no
; overlays, no shadow file, no LUTs, no TCB, no channel state.
;
;   $0000..$12FF  code                        4.7 KB
;   $1300..$133F  published header            68k-visible, and a FIXED address
;   $1400..$16FF  slot ring                   RING_DEPTH × 256
;   $1700..$17FF  free
;   $1900..$195F  PCM voice state             3 × 32 B
;   $1960..$19FF  engine scratch (idle voice struct at $1980)
;   $1A00..$1BFF  SAMPLE RING                 512 B, 512-aligned
;   ..$1EFF       free
;   $1F00         stack top
;
; The planes and the voice state sit ABOVE the ring rather than below it because
; the header's address is the one Z80 constant the 68k compiles in (§6.4): the
; sub-slot consume loop pushed the image past 4 KB, and growing upward into the
; free space is the move that does not make the host's build stale. Code now has
; the whole span below the header, and everything above the ring is the
; engine's own.
;
; The SAMPLE RING (§5.1.2). A sample is only final once the LAST voice has added
; to it, so what the feed can be draining is what the previous frame's mix
; finished — one frame of PCM latency, exactly as the two planes it replaces
; cost. What the ring buys is that the two counts no longer have to be equal:
; Timer B asks for 166 or 167 samples a frame depending on where its phase
; falls, and the mixer just tops the ring back up.
;
; 512 bytes, and 512-ALIGNED, because both regions are live at once — the
; finished samples waiting to be played and the chunk being built. A page edge
; is therefore `L == 0` and the page is one bit of H, which is what lets the
; cursors stay `inc l` / `inc iy` in the hot loops and wrap at SEGMENT
; boundaries instead (see mvf_seg).
RING_BUF    equ $1a00
RING_TOP    equ $1c00
RING_PAGE   equ 1               ; the bit of H that names the ring's two pages
; What a frame has for the LOOPS, in Z80 cycles. Well short of the frame's
; 59,659: what is missing is everything the loops do not do — the slot's writes,
; the pass transitions, the segment set-ups — which the pad must leave room for
; or the frame ends late. Tuned by `npm run dac`: 46000 still reads 96-100%
; paced, and below 42000 the span stops moving, so this is the knee.
PCM_BUDGET  equ 42000
; Finished samples the ring carries ahead of the feed. 255 rather than 256
; because a pass's tick count is a byte (G_TICKS) and the prime frame mixes
; exactly this many; the slack it leaves the feed is 255 - 167 = 88 samples.
PCM_RING_TARGET equ 255
G_PCMV      equ $1900
PCM_V_SIZE  equ 32              ; power-of-two stride: index × 32 is five adds

; Voice struct. Positions are WINDOW ADDRESSES so the mixer's fetch is a bare
; `ld a,(de)`; distances are BYTE COUNTDOWNS so a sample can span ROM banks
; without any absolute end address to rebase (driver.md §5.4).
PV_PTR      equ 0               ; u16 current sample address in the window
PV_FRAC     equ 2               ; u16 fractional position (low half of 16.16)
PV_INCF     equ 4               ; u16 increment fraction
PV_INCI     equ 6               ; u8  increment integer part
PV_SHIFT    equ 7               ; u8  volume attenuation shift (0..7)
PV_FLAGS    equ 8               ; u8  bit0 active, bit1 hasLoop, bit2 releasing
PV_KSH      equ 9               ; u8  segment-bound shift: 2^KSH >= inc (see below)
PV_BANK     equ 10              ; u16 sample ROM bank
PV_LEFT     equ 12              ; u16 bytes until the current boundary
PV_LOOPL    equ 14              ; u16 loop length in bytes
PV_TAIL     equ 16              ; u16 bytes from loop end to sample end

; Engine scratch
G_BASE      equ $1960
G_ACT       equ G_BASE+$00      ; u8  1 = a voice was sounding at frame start
G_DACON     equ G_BASE+$01      ; u8  1 = $2B DAC enable is currently set
G_TICKS     equ G_BASE+$03      ; u8  ticks left in this voice's pass
G_IDX       equ G_BASE+$04      ; u8  buffer tick index
G_OLDPTR    equ G_BASE+$07      ; u16 pointer at segment start
G_SLOT      equ G_BASE+$09      ; u16 slot cursor
G_STARVED   equ G_BASE+$0b      ; u8  1 = this frame found the ring empty
G_INTS      equ G_BASE+$0c      ; u8  vblanks this engine has ANSWERED — the
                                ;     count H_VBL is compared against (§6.7)
G_STORE     equ G_BASE+$0f      ; u8  0 = this pass stores into the plane
; Handed to the generated mixer core (tools/gen-mixer.mjs)
G_SEG_N     equ G_BASE+$10      ; u8  unrolled iterations in the current segment
G_SEG_L     equ G_BASE+$11      ; u8  accumulate flag
G_SEG_I     equ G_BASE+$12      ; u8  buffer index
G_SEG_R     equ G_BASE+$13      ; u8  remainder ticks
G_MIXP      equ G_BASE+$14      ; u8  high byte of the ring page being MIXED
; The pacing loop (§5.1.2): every pad is now a BAKED constant of (role, shift)
; — the gate re-synchronises each group's first sample, so nothing outside the
; loop has to be charged against it and the runtime debt, its estimator and its
; three measurements are gone.
G_NWR       equ G_BASE+$18      ; u8  chip writes this frame's slot carried
G_ACTM      equ G_BASE+$1a      ; u8  which voices were sounding at frame start
G_BIASLO    equ G_BASE+$1b      ; u8  (i16 variant only)
G_BIASHI    equ G_BASE+$1c
; The sub-slot cursor (§3.5). G_SUB is the NEXT sub-slot to put on the chips —
; SLOT_SUBS means the frame has none left, which is also what a starved frame
; starts at. G_PASS counts voice passes, because their boundaries are the
; instants the remaining sub-slots go out on.
G_SUB       equ G_BASE+$1d      ; u8  next sub-slot index, SLOT_SUBS = done
G_PASS      equ G_BASE+$1e      ; u8  voice passes run so far this frame

; A voice struct that is permanently silent. Every frame runs PCM_PASSES passes
; whether or not there are voices to fill them — the feed's cadence is one sample
; per PCM_PASSES ticks, so a missing pass would bunch the samples up — and this
; is what an absent or finished voice runs instead. PV_SHIFT = PCM_MUTE_SH, so
; the mute loops store silence (as the first pass) or add nothing (as a later
; one), and no real voice state is touched.
G_IDLEV     equ $1980

; ── The frame's segment plan (driver.md §6.3.1) ────────────────────────────
; The sequencer already advances every voice's position tick by tick, so it
; knows where each voice's mix has to break — a loop wrap or the end of a
; sample — before the engine does. It ships that as a run of tick counts per
; voice and the engine simply follows them. What it replaces was a 16-bit min,
; a shift loop and, approaching a boundary, a tick-by-tick walk: a per-segment
; cost that swung by an order of magnitude frame to frame, which is exactly the
; kind of variance the pacing pad (§5.1) cannot absorb.
;
; ROM WINDOW crossings are NOT in the plan. The engine owns the bank, a crossing
; can split any planned segment, and it consumes no plan entry — it only ever
; shortens one.
G_PLAN      equ $19a0           ; 3 × {u8 entries left, u16 cursor}, per voice
G_PLANL     equ $19a9           ; u8  entries left in the running pass's run
G_PLANC     equ $19aa           ; u16 cursor into it
G_PLANR     equ $19ac           ; u8  ticks to the next break; 0 = derive it
G_NEARH     equ $19ad           ; u8  ptr high byte at which a window top is near

; Bought back from the pass-boundary path — the stretch of the frame where no
; sample is fed and the DAC is holding (§5.1.2).
G_BANKL     equ $19bd           ; u16 the ROM bank currently latched, $FFFF = none
G_HELD      equ $19bf           ; u8  1 = a ring slot is taken and not yet released

; ── The sample ring's own state (§5.1.2) ───────────────────────────────────
; The feed's cursor lives in IY for the whole frame and is parked here across
; frames; the mixer's lives in HL inside a segment and is parked in G_WR.
G_RD        equ $19c0           ; u16 next sample the feed takes
G_WR        equ $19c2           ; u16 where the mixer writes next
G_FILL      equ $19c4           ; u16 FINISHED samples not yet fed
G_EMITS     equ $19c6           ; u8  samples this frame still owes the DAC
; $19c7 was G_PHASE, the gate countdown. It lives in A' now — the emit gets ~165
; cycles and a RAM byte behind a call spent 69 of them on a counter that never
; exceeds 3 (gate_wait, and gen-mixer.mjs gatePrologue for the rule that AF' is
; the pacing's and nobody else's). Free.
; Our copy of $27. Bits 6-7 are the SEQUENCER's (CH3 mode / CSM, §9) and reach
; us through the slot, which cs_r27 snoops; bits 0-5 are ours (Load B, and the
; flag reset the gate pulses). Neither side may clobber the other's.
G_R27       equ $19c8           ; u8  $27 as we last wrote it
; The same byte with bit 5 (reset flag B) already in it. gate_wait writes $27
; once per Timer B group — ~56 times a frame — and `or $20` there is 7 cycles
; each time on the one emit in the group that is already the frame's slowest
; (measured at 408 cycles against a 358-cycle period). Kept in step wherever
; G_R27 is written; there are only three such places and they are all here.
G_R27G      equ $19cf           ; u8  G_R27 | $20, for the gate's flag reset
G_CHUNK     equ $19c9           ; u8  samples to mix this frame; 0 = a prime frame
G_TICKSF    equ $19ca           ; u8  ticks each pass runs this frame
; The frame's write base, split the way the mixer wants it. Every pass covers
; the SAME chunk, so each one restores these — while a pass may step the page
; mid-way (mvf_ringcap) and must not leave that behind for the next one.
G_WRP       equ $19cb           ; u8  ring page the chunk starts in
G_WRI       equ $19cc           ; u8  index within it
G_PAD       equ $19cd           ; u8  what an IDLE iteration holds to (§5.1.2)


; ── Published header (driver.md §6.4) ──────────────────────────────────────
; The only Z80 addresses the 68000 needs to know, and the only ones that must
; stay stable across builds.
HDR         equ $1300
H_HEAD      equ HDR+0           ; u8  68k-owned: next slot to fill
H_TAIL      equ HDR+1           ; u8  Z80-owned: next slot to consume
H_FRAMES    equ HDR+2           ; u16 Z80-owned: frames CONSUMED — the audible
                                ;     clock. The 68k runs ahead by the ring
                                ;     depth, so `(trig N)` fires against this.
H_READY     equ HDR+4           ; u8  $D2 once the engine is up
H_VER       equ HDR+5           ; u8  protocol version
H_SMPBANK   equ HDR+6           ; u16 68k-owned: PCM sample ROM bank (0 = none)
; The ring's own geometry, so the 68k has ONE compile-time constant (HDR) and
; reads everything else. Both sides have to agree on depth and a mismatch fails
; silently — the 68k would either stall thinking the ring is full or write a
; slot that does not exist — so exactly one side owns the truth, and it is the
; side the numbers are built into.
H_DEPTH     equ HDR+8           ; u8  ring depth in slots
H_SLOTSH    equ HDR+9           ; u8  log2(SLOT_SIZE): a slot index is a shift
H_RING      equ HDR+10          ; u16 ring base address in Z80 RAM
; Frames the engine had to hold the chips because the ring was empty. Not an
; error (driver.md §6.1) — it means the 68k did not keep up, which is otherwise
; INAUDIBLE AS A CAUSE: it presents as the music wobbling, with nothing to point
; at. A counter turns that into a number.
H_STARVE    equ HDR+12          ; u16 Z80-owned: starved frames since boot
; The 68k's vblank counter, stamped by MMLisp_frame inside the bus grab it
; already takes (§6.7). The Z80 cannot see a missed vblank — the VDP holds
; /INT for about a scanline, so an interrupt that is not taken is simply gone
; — but the 68000's own vblank interrupt is not missable the same way. The
; stamp is what lets a frame that ran over budget CATCH UP instead of losing
; a frame of music.
H_VBL       equ HDR+14          ; u8  68k-owned: vblank count, low byte
PROTO_VER   equ 7
READY_MARK  equ $d2

RING        equ $1400
STACK_TOP   equ $1f00

; ===========================================================================
        org 0
        jp   start

; ── vblank interrupt (IM 1): one engine frame ─────────────────────────────
;
; Interrupts stay OFF for the whole frame. An earlier version enabled them here
; to count frames that overran their budget — the successor's vblank would
; re-enter and tally itself. It does not work: the VDP holds Z80 /INT for about
; a scanline, so the SAME vblank re-triggers the moment `ei` executes and every
; frame counts one. Measured on hardware as 1602 "overruns" in 1603 frames.
;
; The number is available from the host anyway and more honestly: frames the
; engine consumed against real elapsed frames (§6.4). If that ratio is below 1
; while `starved_frames` is flat, the Z80 is dropping interrupts — which is what
; an overrun IS.
        org $38
int_handler:
        push af
        push bc
        push de
        push hl
        push ix
        push iy                 ; the mixer's feed cursor (§5.1)
        call frame_step
        ; ── missed-vblank catch-up (§6.7) ───────────────────────────────────
        ; A frame that ran past its budget lost the next vblank OUTRIGHT (see
        ; above — the /INT pulse is a scanline, there is nothing to take late).
        ; But the 68k can see what the Z80 cannot: MMLisp_frame stamps the
        ; 68k's own vblank count into H_VBL. If the stamp is ahead of the
        ; vblanks this handler has answered, the difference is missed frames —
        ; consume them NOW, late, instead of losing them from the music. The
        ; DAC hiccups once; the tempo does not slip.
        ;
        ; A stamp cannot arrive EARLIER than its own vblank, so a positive
        ; difference always means a real miss — the test cannot fire
        ; spuriously. Anything outside the small window (boot, a host that
        ; stamps late, a host restart) resyncs silently and catches up
        ; nothing. Capped per interrupt so a wild stamp cannot stall the
        ; engine; a real backlog heals one frame per interrupt.
        ld   hl,G_INTS
        inc  (hl)               ; this interrupt answered one vblank
        ld   b,CATCH_MAX
ih_catch:
        ld   a,(H_VBL)
        sub  (hl)
        jr   z,ih_done          ; in step
        cp   CATCH_WIN+1
        jr   nc,ih_sync         ; not a plausible miss: adopt the stamp
        inc  (hl)               ; one missed vblank, answered late
        push bc
        push hl
        call frame_step
        pop  hl
        pop  bc
        djnz ih_catch
        jr   ih_done
ih_sync:
        ld   a,(H_VBL)
        ld   (hl),a
ih_done:
        pop  iy
        pop  ix
        pop  hl
        pop  de
        pop  bc
        pop  af
        ei
        reti

; One frame per missed vblank, at most this many per interrupt.
CATCH_MAX   equ 2
; How far ahead a stamp can plausibly run before it reads as noise, not backlog.
CATCH_WIN   equ 8

; ===========================================================================
; Boot. The host uploads this image, publishes H_SMPBANK, then releases reset.
; ===========================================================================
start:
        di
        im   1
        ld   sp,STACK_TOP
        ; Clear the engine's own RAM — the mix planes, the voice state and the
        ; scratch — which all sit above the ring now. The header is below it and
        ; is left alone on purpose: the host may already have written
        ; H_SMPBANK, and head/tail are zeroed explicitly below anyway. The ring
        ; needs no clearing either; a slot is only read once head says it is
        ; there.
        ; …up to the SAMPLE RING's top and not one byte further: $1C00 and above
        ; is cold CODE now (§5.2), and clearing it would erase the routine that
        ; is about to be called.
        ld   hl,$1700
        ld   de,$1701
        ld   bc,RING_TOP-$1700-1
        ld   (hl),0
        ldir
        xor  a
        ld   (H_HEAD),a
        ld   (H_TAIL),a
        ld   (H_FRAMES),a
        ld   (H_FRAMES+1),a
        ld   a,PROTO_VER
        ld   (H_VER),a
        ; Ring geometry, published before ready so the host can read it the
        ; moment H_READY appears.
        ld   a,RING_DEPTH
        ld   (H_DEPTH),a
        ld   a,SLOT_SHIFT
        ld   (H_SLOTSH),a
        ld   hl,RING
        ld   (H_RING),hl
        ld   hl,0
        ld   (H_STARVE),hl
        xor  a
        ld   (H_VBL),a          ; so the first catch-up check reads in-step
        ; PCM: an empty ring (the first frame to sound is a PRIME frame), and
        ; the idle voice is silent forever.
        ld   hl,RING_BUF
        ld   (G_RD),hl
        ld   (G_WR),hl
        ld   a,RING_BUF>>8
        ld   (G_MIXP),a
        ld   a,1
        ex   af,af'             ; A' = the gate phase; the first emit waits
        ld   a,PCM_IDLE_SH
        ld   (G_IDLEV+PV_SHIFT),a
        ; Timer B: TB = 255, so it overflows every 16 FM samples and the engine
        ; emits PCM_GROUP samples per overflow — 9987.6 Hz (§5.1.2).
        ;
        ; $0A = Load B (bit 1) | ENABLE B (bit 3), and BOTH are required. Load B
        ; runs the counter; Enable B is what publishes its overflow to the
        ; status byte the gate polls. Nuked-OPN2 states it in one line
        ; (ym3438.c, OPN2_DoTimerB):
        ;
        ;     timer_b_overflow_flag |= timer_b_overflow & timer_b_enable;
        ;
        ; With bit 3 clear the counter runs and the flag NEVER appears, so
        ; gate_wait spins for ever: the first frame's writes reach the chips —
        ; one note — and the driver never returns. Every harness here modelled
        ; the flag on time regardless of bit 3, so all of them passed against it.
        ;
        ; Enable B also gates the YM2612's /IRQ pin, which is not connected on
        ; the Mega Drive (the Z80's /INT is the VDP's vblank), so setting it
        ; costs nothing and is the ordinary idiom for a driver that polls.
        ;
        ; Both bits have to STAY set from here on, which is why cs_r27 ORs them
        ; back into every $27 the sequencer sends.
        ld   b,255
        ld   c,$26
        call ym_write0
        ld   a,$0a
        ld   (G_R27),a
        or   $20
        ld   (G_R27G),a
        ld   b,a
        ld   c,$27
        call ym_write0
        ; No bank is latched yet, and the register is write-only, so say so with
        ; a value no sample bank can have — the RAM clear would otherwise leave
        ; latch_bank believing bank 0 is live when nothing is.
        ld   hl,$ffff
        ld   (G_BANKL),hl
        ld   a,READY_MARK
        ld   (H_READY),a
        ei
idle:
        halt
        jr   idle

; ===========================================================================
; One frame (driver.md §5.1)
; ===========================================================================
frame_step:
        ; The FEED CURSOR, for the whole frame — loaded HERE and not inside
        ; process_pcm, because consume_slot's write runs carry samples too
        ; (feed_one) and they run first. It used to be loaded after pcm_pad, so
        ; at the head IY was merely whatever the previous frame's `ld (G_RD),iy`
        ; had left in it: correct by luck, and only while nothing between the
        ; two touched IY. An emit at the head is either valid or it is not, and
        ; that should not depend on a register surviving an interrupt.
        ld   iy,(G_RD)
        call consume_slot       ; 1-2: sub-slot 0's writes, and the PCM commands
        call process_pcm        ; 3:   mix and feed the DAC, sub-slots 1..K-1
        call consume_rest       ;      anything the passes could not reach
        call slot_release       ; 4:   the slot is the 68k's again
        ; 5: publish the consumed-frame counter. A STARVED frame consumed no
        ; slot and the music did not advance on it, so it must not tick this —
        ; §6.4 calls it the audible clock and `(trig N)` fires against it.
        ; Counting interrupts here instead made the host's own speed readout
        ; blind to a ring that was starving half the time.
        ld   a,(G_SUB)
        cp   SLOT_SUBS
        ret  nz                 ; still owed sub-slots: cannot happen after
                                ; consume_rest, but a starved frame is the case
        ld   a,(G_STARVED)
        or   a
        ret  nz                 ; nothing was consumed this frame
        ld   hl,(H_FRAMES)
        inc  hl
        ld   (H_FRAMES),hl
        ret

; consume_rest: drain whatever sub-slots are still owed. Normally nothing —
; there is one voice pass per sub-slot past the first — but the tail must not
; be released until the slot is fully read, so the frame ends by making sure.
consume_rest:
        ld   a,(G_SUB)
        cp   SLOT_SUBS
        ret  nc
        call consume_sub
        jr   consume_rest

; ===========================================================================
; Consume one slot (driver.md §6.2)
;
;   [u8 n_writes]
;   [u8 n_pcm][commands…]
;   { [u8 n_psg][val…][u8 n_fm0][{reg,val}…][u8 n_fm1][…] } × SLOT_SUBS
;
; Length-prefixed runs, so the loop needs no per-write dispatch: three tight
; loops with their port address fixed. That property is exactly why the frame
; is divided into sub-slot BLOCKS rather than per-write timestamps.
;
; The two frame-level fields LEAD, and that is not cosmetic: both are wanted
; here, at the frame head — the PCM commands before the mixer runs, `n_writes`
; before `pcm_debt` sizes the frame's pad (§5.1) — while sub-slots 1..K-1 are
; not consumed until a third and two thirds of the way in (§3.5). With them
; trailing, this routine had to walk past every sub-slot to reach them and tally
; every run on the way, which measured ~1,700 cycles a frame.
;
; The tail is NOT released until the last sub-slot has been read: while the 68k
; owns head/tail, the slot's bytes stay ours for the whole frame.
;
; Ring-empty is NOT an error — it means the game overran, so the chips simply
; hold where they are and the mixer keeps running (no PCM gap).
; ===========================================================================
consume_slot:
        xor  a
        ld   (G_HELD),a
        ld   (G_STARVED),a
        ld   (G_NWR),a
        ; No slot means no plan. Zeroing the runs here is what makes a STARVED
        ; frame derive its own bounds instead of replaying the last frame's
        ; breaks, which have already been passed.
        ld   (G_PLAN+0),a
        ld   (G_PLAN+3),a
        ld   (G_PLAN+6),a
        ld   a,SLOT_SUBS
        ld   (G_SUB),a          ; nothing to consume, unless the ring has a slot
        ld   a,(H_TAIL)
        ld   c,a
        ld   a,(H_HEAD)
        cp   c
        jr   nz,cs_have
        ; Ring empty: the 68k did not keep up. Hold the chips, keep mixing, and
        ; count it — this is the one failure that is otherwise unattributable.
        ld   hl,(H_STARVE)
        inc  hl
        ld   (H_STARVE),hl
        ld   a,1
        ld   (G_STARVED),a      ; the audible clock does not tick on this frame
        ret
cs_have:
        ld   a,1
        ld   (G_HELD),a         ; ours until slot_release says otherwise
        ; slot address = RING + tail*256, and RING is page-aligned
        ld   a,c
        add  a,RING>>8
        ld   h,a
        ld   l,0
        ld   a,(hl)             ; the frame's chip writes, all sub-slots
        inc  hl
        ld   (G_NWR),a
        ; What the mixer owes this frame (§5.1.2). It is a field, not something
        ; derived here, because the segment plan below measures its tick
        ; distances against it — a starved frame that guessed would desync the
        ; two. 0 means a PRIME frame, and process_pcm reads that from an empty
        ; ring rather than from here, so a starved frame simply keeps the last
        ; chunk and stays in step.
        ld   a,(hl)
        inc  hl
        or   a
        jr   z,cs_nochunk
        ld   (G_CHUNK),a
cs_nochunk:
        ; The frame's emit budget is settled HERE, before its first long stretch
        ; of work, because that stretch is the slot's own writes and they carry
        ; samples now (§5.1.2). A PRIME frame — an empty ring — owes nothing yet;
        ; process_pcm reads the same G_FILL and agrees.
        ld   de,(G_FILL)
        ld   a,(G_DACON)
        or   a
        jr   z,cs_emits         ; not claimed yet: nothing to feed
        ld   a,d
        or   e
        jr   z,cs_emits         ; prime: the lead is built, nothing is fed
        ld   a,(G_CHUNK)
cs_emits:
        ld   (G_EMITS),a        ; both skips leave A = 0, which is the answer

        ld   b,(hl)
        inc  hl
        ld   a,b
        or   a
        jr   z,cs_plans         ; no commands, but the plan still has to be read
cs_cmd:
        push bc
        call pcm_command        ; advances HL past the command
        pop  bc
        djnz cs_cmd

        ; The segment plan: PCM_VOICES count-prefixed runs (§6.3.1). Recording
        ; where each voice's run STARTS is all that is needed here; the pass
        ; reads its own entries as it breaks.
cs_plans:
        ld   de,G_PLAN
        ld   b,PCM_VOICES
cs_plan:
        ld   a,(hl)             ; entries in this voice's run
        inc  hl
        ld   (de),a
        inc  de
        ex   de,hl
        ld   (hl),e             ; …and where they start
        inc  hl
        ld   (hl),d
        inc  hl
        ex   de,hl
        add  a,l                ; step over them (a slot never crosses a page)
        ld   l,a
        djnz cs_plan


cs_subs:
        call cs_runs            ; sub-slot 0, at the frame head as always
        ld   (G_SLOT),hl        ; where sub-slot 1 begins
        ld   a,1
        ld   (G_SUB),a
        cp   SLOT_SUBS
        ret  c                  ; more sub-slots to come: the slot stays ours
        jp   slot_release       ; SLOT_SUBS = 1: it is the 68k's again already

; ---------------------------------------------------------------------------
; slot_release: hand the slot back, once.
;
; The slot goes back the moment its last sub-slot has been read — the 68k
; renders from a loop woken by the SAME vblank, so its render lands inside the
; engine's frame and every cycle the slot is held is lookahead taken from it.
; The last time this engine got ring timing wrong it reached hardware as
; half-speed music (§3.4).
;
; G_HELD makes it once-only, because two paths can reach it: the last sub-slot's
; consume, and the end of the frame for a frame that never got that far.
; ---------------------------------------------------------------------------
slot_release:
        ld   a,(G_HELD)
        or   a
        ret  z                  ; nothing taken, or already handed back
        xor  a
        ld   (G_HELD),a
        ld   a,(H_TAIL)
        inc  a
        cp   RING_DEPTH
        jr   c,sr_store
        xor  a
sr_store:
        ld   (H_TAIL),a
        ret

; ---------------------------------------------------------------------------
; consume_sub: put the next sub-slot on the chips, if the frame still owes one.
; Called at the mixer's voice-pass boundaries — which sit at 1/3 and 2/3 of a
; paced frame (§5.1), so the sub-tick instants come for free.
; ---------------------------------------------------------------------------
consume_sub:
        ld   a,(G_SUB)
        cp   SLOT_SUBS
        ret  nc
        inc  a
        ld   (G_SUB),a
        ld   hl,(G_SLOT)
        call cs_runs
        ld   (G_SLOT),hl
        ; The mixer's feed writes $2A BLIND (§5.1) — the address is latched once
        ; a frame and never again. A sub-slot carrying any YM port-0 write moves
        ; that latch, so put it back before the next mix tick, or the rest of
        ; the frame's samples land in whatever register the slot touched last.
        call ym_busy0
        ld   a,$2a
        ld   (YM_ADDR0),a
        ; The last sub-slot has been read, so nothing will look at the slot
        ; again: hand it straight back — the 68k renders inside this very frame
        ; and wants the lookahead.
        ld   a,(G_SUB)
        cp   SLOT_SUBS
        ret  c
        jp   slot_release

; ---------------------------------------------------------------------------
; cs_runs: put one sub-slot's three runs on the chips. HL = its first byte on
; entry, the byte after its last run on exit.
; ---------------------------------------------------------------------------
cs_runs:
        ; ── PSG run: bare bytes, no wait needed ──
        ld   a,(hl)
        inc  hl
        ld   b,a
        or   a
        jr   z,cr_fm0
cr_psg:
        ld   a,(hl)
        ld   (PSG_PORT),a
        inc  hl
        djnz cr_psg

cr_fm0:
        ld   a,(hl)
        inc  hl
        ld   b,a
        or   a
        jr   z,cr_fm1
        ; The BUSY polls are INLINE here, not `call ym_busy0`. A call/ret round
        ; trip is 27 cycles on each of two polls a write, and this loop runs
        ; while the DAC is holding its last sample — 54 cycles a write is ~2.2k
        ; on a 40-write frame, which is real budget on a frame that has none.
cr_p0:
        ld   a,(YM_ADDR0)
        rla
        jr   c,cr_p0
        ld   a,(hl)
        cp   $27
        jr   z,cs_r27           ; shared with the sample clock — merge, not clobber
        ld   (YM_ADDR0),a
        inc  hl
cr_p0d:
        ld   a,(YM_ADDR0)
        rla
        jr   c,cr_p0d
        ld   a,(hl)
        ld   (YM_DATA0),a
        inc  hl
        ; …and a sample goes out with every FOURTH one. A run of chip writes is
        ; the longest stretch of work a frame has — 40 of them is 12 sample
        ; periods of the DAC holding its last byte (§5.1.2) — and four writes is
        ; ~450 cycles, near enough one sample period. Every write would be three
        ; times the frame's fair share and would starve the mix passes of budget
        ; instead, which is the same dead time moved somewhere else.
        djnz cr_p0
        jr   cr_fm1

; $27 is the one register both CPUs write. Bits 6-7 are the sequencer's (CH3
; mode / CSM, §9); bits 0-5 are the engine's, and Load B AND Enable B among them
; have to stay set or the sample clock stops — Load B runs the counter, Enable B
; is what puts its overflow in the status byte the gate polls, and dropping
; either one hangs gate_wait for ever (see the boot's $27 write). So the byte is
; merged on its way through and remembered, because the gate's flag reset
; (gate_wait) has to write the same register without losing the mode the score
; asked for.
cs_r27:
        ld   (YM_ADDR0),a
        inc  hl
        ld   a,(hl)
        or   $0a                ; Load B | Enable B — ours, always
        ld   (G_R27),a
        push af
        or   $20
        ld   (G_R27G),a         ; …and the gate's copy, kept in step here
        pop  af
cs_r27d:
        ld   a,(YM_ADDR0)
        rla
        jr   c,cs_r27d
        ld   a,(G_R27)
        ld   (YM_DATA0),a
        inc  hl
        ld   a,b
        and  3
        call z,feed_one
        djnz cr_p0

cr_fm1:
        ld   a,(hl)
        inc  hl
        ld   b,a
        or   a
        ret  z
cr_p1:
        ld   a,(YM_ADDR0)       ; the status byte is port 0's, on both parts
        rla
        jr   c,cr_p1
        ld   a,(hl)
        ld   (YM_ADDR1),a
        inc  hl
cr_p1d:
        ld   a,(YM_ADDR0)
        rla
        jr   c,cr_p1d
        ld   a,(hl)
        ld   (YM_DATA1),a
        inc  hl
        ; …and a sample goes out with every fourth one here too. This used to
        ; zero every sample, and the cause was the FEED CURSOR: `ld iy,(G_RD)`
        ; lived inside process_pcm, which runs AFTER consume_slot, so at the
        ; frame head IY was only whatever the previous frame's `ld (G_RD),iy`
        ; had left in it. The port-0 loop got away with it; a second emit site
        ; walked IY far enough off that the mixer's own reads came back wrong,
        ; which presented as a bad ROM bank. IY is loaded in frame_step now, so
        ; an emit at the head is valid by construction rather than by luck.
        ld   a,b
        and  3
        call z,feed_one
        djnz cr_p1
        ret

; ym_busy0: poll the status byte until BUSY (bit 7) clears. The DAC data
; register is exempt and is fed blind by the mixer (driver.md §5.1).
ym_busy0:
        ld   a,(YM_ADDR0)
        rla
        jr   c,ym_busy0
        ret

; ===========================================================================
; PCM commands (driver.md §6.3). HL = command cursor, advanced past the
; command on return. Every field arrives register-ready.
; ===========================================================================
PCMC_START  equ 1
PCMC_STOP   equ 2
PCMC_VOL    equ 3
PCMC_LOOP   equ 4

pcm_command:
        ld   a,(hl)
        inc  hl
        dec  a
        jp   z,pc_start
        dec  a
        jp   z,pc_stop
        dec  a
        jp   z,pc_vol
        dec  a
        jp   z,pc_loop
        ret                     ; unknown opcode: the count already bounds us

; voice_ptr: A = voice index → IX = &G_PCMV[A]. PCM_V_SIZE is a power of two,
; so this is a shift, not a multiply.
voice_ptr:
        push hl
        ld   l,a
        ld   h,0
        add  hl,hl              ; ×2
        add  hl,hl              ; ×4
        add  hl,hl              ; ×8
        add  hl,hl              ; ×16
        add  hl,hl              ; ×32
        ld   de,G_PCMV
        add  hl,de
        push hl
        pop  ix
        pop  hl
        ret

; PCM_START — 17-byte payload:
;   voice, flags, shift, ksh, bank u16, ptr u16, left u16, loopl u16,
;   tail u16, incf u16, inci
pc_start:
        ld   a,(hl)
        inc  hl
        call voice_ptr
        ld   a,(hl)
        inc  hl
        or   1                  ; the command itself means "active"
        ld   (ix+PV_FLAGS),a
        ld   a,(hl)
        inc  hl
        ld   (ix+PV_SHIFT),a
        ld   a,(hl)
        inc  hl
        ld   (ix+PV_KSH),a
        call rd16
        ld   (ix+PV_BANK),e
        ld   (ix+PV_BANK+1),d
        call rd16
        ld   (ix+PV_PTR),e
        ld   (ix+PV_PTR+1),d
        call rd16
        ld   (ix+PV_LEFT),e
        ld   (ix+PV_LEFT+1),d
        call rd16
        ld   (ix+PV_LOOPL),e
        ld   (ix+PV_LOOPL+1),d
        call rd16
        ld   (ix+PV_TAIL),e
        ld   (ix+PV_TAIL+1),d
        call rd16
        ld   (ix+PV_INCF),e
        ld   (ix+PV_INCF+1),d
        ld   a,(hl)
        inc  hl
        ld   (ix+PV_INCI),a
        ld   (ix+PV_FRAC),0
        ld   (ix+PV_FRAC+1),0
        ret

; PCM_STOP — voice. A looped voice starts its release tail: the boundary moves
; from the loop end to the sample end, so it plays out instead of wrapping. A
; shot is already heading for its end and is unaffected.
pc_stop:
        ld   a,(hl)
        inc  hl
        call voice_ptr
        bit  0,(ix+PV_FLAGS)
        ret  z
        bit  1,(ix+PV_FLAGS)    ; hasLoop?
        ret  z
        res  1,(ix+PV_FLAGS)    ; stop wrapping
        set  2,(ix+PV_FLAGS)    ; releasing
        push hl                 ; HL is the COMMAND CURSOR — every handler must
        ld   l,(ix+PV_LEFT)     ; return it untouched, or the rest of the slot's
        ld   h,(ix+PV_LEFT+1)   ; commands are read from garbage
        ld   e,(ix+PV_TAIL)
        ld   d,(ix+PV_TAIL+1)
        add  hl,de              ; left += tail
        ld   (ix+PV_LEFT),l
        ld   (ix+PV_LEFT+1),h
        pop  hl
        ret

; PCM_VOL — voice, shift. Composed on the 68k from :vel + :vol + :master
; (driver.md §14); the mixer applies it as an arithmetic shift per sample.
pc_vol:
        ld   a,(hl)
        inc  hl
        call voice_ptr
        ld   a,(hl)
        inc  hl
        ld   (ix+PV_SHIFT),a
        ret

; PCM_LOOP — voice, loopl u16, left u16. Retargeting a running voice's loop
; region costs the mixer nothing: a voice-outer pass reads the bounds once per
; segment, never per tick (driver.md §1.2).
pc_loop:
        ld   a,(hl)
        inc  hl
        call voice_ptr
        call rd16
        ld   (ix+PV_LOOPL),e
        ld   (ix+PV_LOOPL+1),d
        call rd16
        ld   (ix+PV_LEFT),e
        ld   (ix+PV_LEFT+1),d
        ret

; rd16: DE = u16 at (HL), HL advanced.
rd16:
        ld   e,(hl)
        inc  hl
        ld   d,(hl)
        inc  hl
        ret

; ===========================================================================
; PCM (driver.md §5.3, §5.4)
; ===========================================================================
; One frame: drain the ring into the DAC at Timer B's rate while mixing this
; frame's chunk into it. The feed is INSIDE the mix loops (§5.1.2) — one $2A
; write every PCM_PASSES ticks, each group's first sample held to the gate — so
; the samples come out on the YM's own clock and not on the frame's.
process_pcm:
        call pcm_any_active
        ld   (G_ACT),a          ; 1 = a voice was sounding at frame start
        or   a
        jr   nz,pp_run
        ; fm6 IS CLAIMED FOR THE REST OF THE SCORE. Once PCM has sounded once
        ; the ring is kept topped up with silence and the DAC is never
        ; released, because releasing it makes the NEXT hit a PRIME frame — and
        ; a prime frame feeds nothing while it builds the lead, measured at 135
        ; to 355 sample periods of DAC silence, one to two whole frames, once
        ; per burst. On a percussion track that is a click on every hit.
        ;
        ; The cost is fm6: §14's "claimed, not owned" becomes claimed and kept.
        ; A score with no PCM in it never claims, so it keeps fm6 and reaches
        ; pp_quiet as before.
        ld   a,(G_DACON)
        or   a
        jr   nz,pp_run          ; claimed: keep the ring fed, silence and all

; The mixer was not entered, so there are no voice passes for the remaining
; sub-slots to ride. Pace them by hand — otherwise a score with no PCM in it
; would silently lose its sub-ticks and put the whole frame out at once, which
; is precisely the timing this exists to remove. Costs nothing when the frame
; owes no sub-slots (SLOT_SUBS = 1, or a starved ring).
pp_quiet:
        ld   a,(G_SUB)
        cp   SLOT_SUBS
        ret  nc
        call pace_sub
        call consume_sub
        jr   pp_quiet

; pace_sub: burn one sub-tick's worth of frame. A frame is 59,659 Z80 cycles,
; so a third of one is 19,886. The inner `djnz` costs 13 cycles an iteration,
; making an outer pass 13·N + 18 and the whole loop 12 + M·(13·N + 18):
; M = 10, N = 152 gives 19,952 — 0.3% long, ~18 µs, an order of magnitude
; inside the millisecond this is trying to hit. Retune both if SLOT_SUBS moves.
PACE_IDLE_M equ 10
PACE_IDLE_N equ 152
pace_sub:
        ld   d,PACE_IDLE_M
pq_out:
        ld   b,PACE_IDLE_N
pq_in:
        djnz pq_in
        dec  d
        jr   nz,pq_out
        ret

pp_run:
        ld   a,(G_DACON)
        or   a
        jr   nz,pp_feed
        ld   a,1
        ld   (G_DACON),a
        ld   b,$80
        ld   c,$2b              ; DAC enable — claimed, not owned (§14)
        call ym_write0

pp_feed:
        ; PRIME or STEADY (§5.1.2)? An empty ring is a burst's first frame (or a
        ; recovery after one ran dry): it builds the whole lead and feeds
        ; nothing, parking the DAC at silence with one byte so claiming fm6
        ; cannot step it to whatever the last burst left latched. Every frame
        ; after it mixes exactly what the feed takes, which is what keeps the
        ; two counts equal — one emit per PCM_PASSES ticks, so a frame that
        ; mixes `chunk` feeds `chunk`.
        ld   a,$2a
        ld   (YM_ADDR0),a       ; latched once a frame; the feed writes blind
        ;
        ; The ring's fill is settled HERE rather than at the frame's end,
        ; because at this point it is a constant of which case we are in:
        ;   prime   +TARGET and feed nothing
        ;   steady  mix what is fed, so the fill does not move at all
        ;   tail    nothing to mix, feed `chunk` out of what is left
        ld   hl,(G_FILL)
        ld   a,h
        or   l
        jr   nz,pp_steady
        ld   a,$80
        ld   (YM_DATA0),a       ; park the DAC at silence for this one frame
        ld   a,PCM_RING_TARGET
        ld   (G_TICKSF),a
        ld   hl,PCM_RING_TARGET
        ld   (G_FILL),hl
        xor  a
        ld   (G_EMITS),a        ; …and feed nothing while the lead is built
        jr   pp_setup
pp_steady:
        ; Mix what the feed takes, so the fill stays put — and that now holds
        ; whether or not anything is SOUNDING. A silent frame runs its passes
        ; through G_IDLEV and stores silence, which is what keeps the ring from
        ; draining; the burst's real tail plays out ahead of it in FIFO order.
        ; The separate draining `pp_tail` case is gone with the release.
        ld   a,(G_CHUNK)
        ld   (G_TICKSF),a
pp_emits:
        ; The budget was settled in consume_slot, BEFORE the head's writes spent
        ; part of it (§5.1.2) — so it must not be reset here. A STARVED frame
        ; never got that far, and still owes the DAC a frame.
        ld   a,(G_STARVED)
        or   a
        jr   z,pp_setup
        ld   a,(G_CHUNK)
        ld   (G_EMITS),a
pp_setup:
        ; Which voices are sounding, taken now: a voice can end DURING its pass,
        ; and the count of passes is what the feed's cadence rests on.
        ld   a,(G_PCMV+0*PCM_V_SIZE+PV_FLAGS)
        and  1
        ld   c,a
        ld   a,(G_PCMV+1*PCM_V_SIZE+PV_FLAGS)
        and  1
        add  a,a
        or   c
        ld   c,a
        ld   a,(G_PCMV+2*PCM_V_SIZE+PV_FLAGS)
        and  1
        add  a,a
        add  a,a
        or   c
        ld   (G_ACTM),a

        call pcm_pad            ; what the silent passes may hold to
        ld   hl,(G_WR)          ; …and where this frame's chunk is written
        ld   a,l
        ld   (G_WRI),a
        ld   a,h
        ld   (G_WRP),a

        xor  a
        ld   (G_PASS),a         ; the pass boundaries are the sub-ticks
        ld   (G_STORE),a        ; the first pass stores, which removes the clear

        ; The sounding voices go first and the silent passes after them, because
        ; the silent ones hold nearly all of the frame's pad — and by the time
        ; they run, the frame's real cost (its segment count) is KNOWN rather
        ; than estimated. Order does not change the mix: a silent pass adds
        ; nothing, and the sounding voices keep their own order, which is what
        ; the saturating add depends on.
        ld   c,0
pp_act:
        call pp_voice_at
        jr   nz,pp_act_run
        jr   pp_act_next
pp_act_run:
        push bc                 ; the mixer owns BC for its register file
        ; Bind this voice's plan run before the pass reads it.
        ld   a,c
        add  a,a
        add  a,c                ; ×3: {entries, cursor}
        ld   hl,G_PLAN
        add  a,l
        ld   l,a
        ld   a,(hl)
        ld   (G_PLANL),a
        inc  hl
        ld   a,(hl)
        inc  hl
        ld   h,(hl)
        ld   l,a
        ld   (G_PLANC),hl
        call mix_voice_frame
        call pp_pass_done
        pop  bc
pp_act_next:
        inc  c
        ld   a,c
        cp   PCM_VOICES
        jr   c,pp_act

        ld   c,0
pp_idle:
        call pp_sounding_at     ; no IX: G_IDLEV replaces it below anyway
        jr   z,pp_idle_run
        jr   pp_idle_next
pp_idle_run:
        ld   ix,G_IDLEV
        push bc
        call mix_voice_frame
        call pp_pass_done
        pop  bc
pp_idle_next:
        inc  c
        ld   a,c
        cp   PCM_VOICES
        jr   c,pp_idle

        ; Whatever the frame still owes: a segment shorter than the cadence
        ; leaves its ticks to the single-tick copies, which carry no emit.
        ; G_EMITS is the debt itself now — every emit site charges it, and the
        ; mix loops charge theirs a segment at a time — so there is nothing to
        ; reconstruct here. Normally one sample, at the frame's end.
        ld   a,(G_EMITS)
        ld   b,a
        call flush_rest
        ld   (G_RD),iy          ; park the feed cursor for the next frame
        ; …and put the write cursor back where it belongs: RIGHT AFTER the
        ; finished samples, which is what "the mixer writes at read + fill"
        ; means. DERIVED rather than stepped, because the two do not move
        ; together — a tail frame feeds a chunk and mixes silence, so the cursor
        ; advances by however much of the chunk the tail could not cover — and an
        ; incremental version of that drifts the moment a case is missed.
        ld   hl,(G_RD)
        ld   de,(G_FILL)
        add  hl,de
        ld   a,h
        cp   RING_TOP>>8
        jr   c,pp_wrst
        ld   de,RING_TOP-RING_BUF
        or   a
        sbc  hl,de
pp_wrst:
        ld   (G_WR),hl
        ld   a,(G_ACT)
        or   a
        ret  nz
        ; Nothing is sounding — but the RING may still owe a tail, and releasing
        ; fm6 while it does would hand the channel back to FM mid-sample and
        ; claim it again next frame. So the DAC is released on the frame the ring
        ; runs dry, not the frame the last voice ends (§14).
        ld   hl,(G_FILL)
        ld   a,h
        or   l
        ret  nz
        xor  a
        ld   (G_DACON),a
        ld   b,0
        ld   c,$2b
        jp   ym_write0

; pp_pass_done: one voice pass is over. Every pass after the first accumulates
; into the plane instead of storing, and every boundary but the last is a
; sub-tick (§3.5): the passes already divide a paced frame into thirds, so the
; sub-slots ride the boundaries that were there anyway.
pp_pass_done:
        ld   a,1
        ld   (G_STORE),a
        ld   hl,G_PASS
        inc  (hl)
        ld   a,(hl)
        cp   PCM_VOICES
        ret  nc                 ; the last pass: nothing follows it in the frame
        ; A pass boundary carries a sample. Measured, this was the largest
        ; RECURRING hole in the feed — 30 sample periods with no $2A write —
        ; because the bookkeeping above runs straight into consume_sub's run of
        ; chip writes, and port 1's loop carries no emit of its own (see cr_p1).
        ; The loops around it emit at 266 cycles against a 358 period, so the
        ; frame has the slack; it just was not spent here.
        call feed_one
        jp   consume_sub

; pp_voice_at: IX = voice C, Z clear if it was sounding at frame start. C is
; preserved; A and the flags are not.
pp_voice_at:
        push bc
        ld   a,c
        call voice_ptr
        pop  bc
        ; fall through — the pointer is set, now answer the question

; pp_sounding_at: Z clear if voice C was sounding at frame start, WITHOUT
; touching IX. The silent-pass loop overwrites IX with G_IDLEV the moment it
; decides, so computing a voice pointer for it was ~470 cycles a frame spent on
; a value that is thrown away — and those cycles come straight off the DAC's
; pad (§5.1). C is preserved; A and the flags are not.
pp_sounding_at:
        push bc
        ld   a,(G_ACTM)
        inc  c
pv_sh:
        dec  c
        jr   z,pv_test
        rrca
        jr   pv_sh
pv_test:
        and  1
        pop  bc
        ret

; gate_wait: hold until Timer B overflows, then clear its flag (§5.1.2).
;
; This is the whole of the pacing. GROUP samples come out per overflow, so one
; emit in GROUP calls this and the other two are placed by the code that follows
; — which is what the loops' pad is for. The phase that decides which is A', the
; SHADOW ACCUMULATOR: `ex af,af'` reaches it in 4 cycles where a RAM byte behind
; a call cost 69, and an emit only gets ~165. See gen-mixer.mjs gatePrologue for
; the block every emit site carries, and for the one rule that comes with it —
; **AF' BELONGS TO THE PACING AND NOTHING ELSE MAY USE IT.** The interrupt
; handler's push/pop af does not, which is why the phase survives the frame
; boundary; it is CONTINUOUS on purpose, because a frame carries 166 or 167
; samples, neither divides GROUP, and a phase that restarted per frame would put
; a wait at every frame boundary — a hole 60 times a second.
;
; The flag is bit 1 of the YM status byte and is cleared by writing $27 with bit
; 5 — the register that also carries the CH3/CSM mode bits, which is why G_R27
; exists and why cs_r27 keeps it current. That write costs the DAC's address
; latch, so $2A is re-latched before returning: the feed writes it blind.
;
; Called from inside the mixer's loops, where the register file is live — it
; touches A and the flags and nothing else, and it RETURNS A = PCM_GROUP, which
; is the caller's reloaded phase.
gate_wait:
        ; One test for both conditions. BUSY is bit 7 and Timer B's overflow is
        ; bit 1, and what this loop wants is "not busy AND the flag is up" —
        ; which is the two bits being exactly $02. The shift-and-branch pair it
        ; replaces (add a,a / jr c / bit 2,a / jr z) asked them separately for
        ; 39 cycles; this is 34, on the emit that is already the frame's
        ; slowest and runs ~56 times.
        ld   a,(YM_ADDR0)
        and  $82
        cp   $02
        jr   nz,gate_wait
        ld   a,$27
        ld   (YM_ADDR0),a
        ld   a,(G_R27G)         ; reset flag B; the mode bits are the score's
        ld   (YM_DATA0),a
        ld   a,$2a
        ld   (YM_ADDR0),a       ; re-latch: the feed writes $2A blind
        ld   a,PCM_GROUP        ; the caller's phase, reloaded
        ret

; pcm_any_active: returns NZ if any voice is sounding.
pcm_any_active:
        ld   a,(G_PCMV+0*PCM_V_SIZE+PV_FLAGS)
        and  1
        ret  nz
        ld   a,(G_PCMV+1*PCM_V_SIZE+PV_FLAGS)
        and  1
        ret  nz
        ret

; ---------------------------------------------------------------------------
; mix_voice_frame: run one voice for a whole frame, split into segments that
; cannot cross a loop or sample boundary. IX = voice, G_STORE = this pass's role.
;
; The pass always runs its full G_TICKSF ticks — silently, through G_IDLEV, if
; the voice is absent or ends part-way. That is what makes the interleaved feed
; work: chunk ticks × PCM_PASSES passes carry exactly chunk samples, whatever is
; sounding. It also subsumes the old early-end silence fill, since a silent
; storing pass writes the ring's silence value as it goes.
;
; The split is the point of a voice-outer pass: the inner loop carries no
; bounds check at all, and the check runs a handful of times per frame instead
; of chunk times.
;
; Segment length is bounded conservatively — `avail >> KSH` where 2^KSH >= inc
; — so the engine never has to divide. KSH arrives from the 68k with the note.
; The bound is safe at any length because the fetch precedes the advance: while
; one byte remains, one more tick is always legal.
; ---------------------------------------------------------------------------
mix_voice_frame:
        ld   a,(G_TICKSF)
        ld   (G_TICKS),a
        ld   a,(G_WRI)          ; every pass covers the same chunk of the ring
        ld   (G_IDX),a
        ld   a,(G_WRP)
        ld   (G_MIXP),a
        bit  0,(ix+PV_FLAGS)
        jp   z,mvf_idle         ; no voice here: a silent pass, for the cadence
        call feed_one           ; a pass transition is ~7 sample periods of
        ld   l,(ix+PV_BANK)     ; work with no sample in it (§5.1.2)
        ld   h,(ix+PV_BANK+1)
        call latch_bank         ; once per voice per frame, not per tick
        call feed_one
        ; Bind the pass's specialised loop copies and its pad. (role, shift) is
        ; constant for the whole pass, so this belongs here and not in the
        ; per-segment path where it used to sit.
        ld   a,(G_STORE)
        ld   (G_SEG_L),a
        call ms_bind
        ; How close to the ROM window top the pointer has to be before a
        ; crossing is possible at all: a pass consumes at most R << KSH bytes.
        ; Below this the window test is two instructions and always falls
        ; through, which is what nearly every segment of nearly every frame
        ; does.
        ld   a,(G_TICKSF)
        ld   l,a
        ld   h,0
        ld   a,(ix+PV_KSH)
        or   a
        jr   z,mvf_nearh
mvf_nsh2:
        add  hl,hl
        dec  a
        jr   nz,mvf_nsh2
mvf_nearh:
        ld   a,255
        sub  h
        ld   (G_NEARH),a
        call plan_next          ; ticks to this voice's first break
        call feed_one
        ; The register file — DE = ptr, C = incInt, HL' = frac, DE' = incFrac
        ; — is LIVE for the whole pass (§5.1 (b)): loaded once here, stored
        ; once at pass end, and every boundary below works on the registers
        ; instead of round-tripping the struct each segment.
        call ms_pload

mvf_seg:
        ld   a,(G_TICKS)
        or   a
        jp   z,ms_pstore        ; pass done — flush the file, ret to the caller
        ld   b,a                ; ticks this pass still owes
        ld   a,(G_PLANR)
        or   a
        jr   z,mvf_derive       ; no plan for this stretch: work the bound out
        cp   b
        jr   nc,mvf_win         ; the break is past the end of the pass
        ld   b,a                ; n = ticks to the break
mvf_win:
        ; A window top can split a planned segment. It consumes no plan entry —
        ; it only ever shortens this one — and below G_NEARH it cannot happen.
        ld   a,(G_NEARH)
        cp   d
        jr   nc,mvf_ring
        call mvf_wincap
mvf_ring:
        ; …and so can the RING's two edges (§5.1.2). Neither cursor may wrap
        ; inside a loop — the mixer's is `inc l` and the feed's is `inc iy`, and
        ; making either of them page-aware would cost cycles on every tick of
        ; every frame. So both are bounds here instead, where a compare costs
        ; nothing: a segment simply stops at the edge and the next one starts
        ; after it.
        call feed_one           ; a segment's bound is ~3 periods of work, and
        call mvf_ringcap        ; the bound is measured from IY, so it goes first
        jr   mvf_n

mvf_derive:
        ; No plan: a starved frame carries none, and a loop that breaks more
        ; often than a run can carry runs out of one. Bound the segment the way
        ; the engine did before the plan existed — avail = min(PV_LEFT, bytes to
        ; the window top), n = avail >> KSH. Conservative by up to 2x, so it
        ; halves toward a boundary and costs extra segments; that is the price
        ; of a path that only rare frames take.
        ld   l,(ix+PV_LEFT)
        ld   h,(ix+PV_LEFT+1)
        add  hl,de              ; LEFT + ptr carries out of 16 bits exactly
        jr   c,mvf_dist         ; when the window top is the nearer bound
        sbc  hl,de              ; carry is clear: HL = LEFT again
        jr   mvf_shift
mvf_dist:
        xor  a
        ld   l,a
        ld   h,a
        sbc  hl,de              ; avail = $10000 - ptr
mvf_shift:
        ld   a,(ix+PV_KSH)
        or   a
        jr   z,mvf_nsh
        ld   b,a
mvf_sh:
        srl  h
        rr   l
        djnz mvf_sh
mvf_nsh:
        ld   a,h
        or   a
        jr   nz,mvf_cap         ; >= 256 ticks available: cap at the frame
        ld   a,l
        or   a
        jr   nz,mvf_capl
        inc  a                  ; forced progress
        jr   mvf_capl
mvf_cap:
        ld   a,255
mvf_capl:
        ld   b,a                ; B = n — C belongs to the live file now
        ld   a,(G_TICKS)
        cp   b
        jr   nc,mvf_dcap
        ld   b,a                ; n = min(n, ticks left)
mvf_dcap:
        call feed_one           ; …and a DERIVED bound is longer still
        call mvf_ringcap
mvf_n:
        ld   (G_OLDPTR),de      ; consumption is measured on the live pointer
        push bc                 ; B = n; the copies count it down to 0
        call mix_seg_live
        pop  bc
        ; Ring edges (§5.1.2), taken FIRST because everything below this is
        ; conditional and one of those branches used to jump straight over it:
        ; a segment that ended on the page edge then carried on writing into the
        ; base page, over the samples the feed had not read yet. mvf_ringcap
        ; made sure the segment stopped ON an edge if it reached one, so this is
        ; a test and not arithmetic.
        push bc
        ld   a,(G_IDX)
        or   a
        jr   nz,mvf_rfeed
        ld   a,(G_MIXP)
        xor  RING_PAGE          ; the ring's two pages differ in one bit
        ld   (G_MIXP),a
mvf_rfeed:
        call feed_wrap
        pop  bc
        ld   a,(G_TICKS)
        sub  b
        ld   (G_TICKS),a
        ld   a,(G_PLANR)        ; the break is B ticks nearer (0 stays 0)
        sub  b
        jr   nc,mvf_planr
        xor  a
mvf_planr:
        ld   (G_PLANR),a

        ; LEFT -= (ptr - oldptr), touching neither DE nor C
        ld   hl,(G_OLDPTR)
        ld   a,e
        sub  l
        ld   l,a
        ld   a,d
        sbc  a,h
        ld   h,a                ; HL = bytes consumed
        ld   a,(ix+PV_LEFT)
        sub  l
        ld   (ix+PV_LEFT),a
        ld   a,(ix+PV_LEFT+1)
        sbc  a,h
        ld   (ix+PV_LEFT+1),a
        jr   nc,mvf_wtop        ; the forced one-tick segment (avail >> KSH == 0)
        xor  a                  ; may consume more than LEFT — clamp, or the
        ld   (ix+PV_LEFT),a     ; countdown wraps and the voice runs off the end
        ld   (ix+PV_LEFT+1),a
mvf_wtop:
        ; window top crossed? the pointer left $8000..$FFFF, so step the bank.
        ; The pointer is live: fix D in place.
        ld   a,d
        cp   WINDOW>>8
        jr   nc,mvf_bound
        add  a,WINDOW>>8
        ld   d,a
        ld   l,(ix+PV_BANK)
        ld   h,(ix+PV_BANK+1)
        inc  hl
        ld   (ix+PV_BANK),l
        ld   (ix+PV_BANK+1),h
        call latch_bank

mvf_bound:
        call feed_one           ; the wrap / window step / plan refill between
        ld   a,(ix+PV_LEFT)     ; two segments carries a sample too
        or   (ix+PV_LEFT+1)
        jp   nz,mvf_seg         ; still inside the region
        bit  1,(ix+PV_FLAGS)    ; loops, and not releasing → wrap
        jr   z,mvf_end
        ; ptr -= loop length, LEFT = loop length — on the live file
        ld   l,(ix+PV_LOOPL)
        ld   h,(ix+PV_LOOPL+1)
        ex   de,hl              ; DE = loop length, HL = ptr
        or   a
        sbc  hl,de
        ex   de,hl              ; DE = wrapped ptr, HL = loop length
        ld   (ix+PV_LEFT),l     ; LEFT = loop length
        ld   (ix+PV_LEFT+1),h
        call plan_next          ; the wrap consumed one break
        ld   a,d
        cp   WINDOW>>8
        jp   nc,mvf_seg
        add  a,WINDOW>>8        ; wrapped back below the window: previous bank
        ld   d,a
        ld   l,(ix+PV_BANK)
        ld   h,(ix+PV_BANK+1)
        dec  hl
        ld   (ix+PV_BANK),l
        ld   (ix+PV_BANK+1),h
        call latch_bank
        jp   mvf_seg

mvf_end:
        ; Shot or release tail finished — the rest of the pass runs silent.
        res  0,(ix+PV_FLAGS)

; mvf_idle: run what is left of this pass through the mute loop. As the storing
; pass it writes silence into the plane; as a later one it adds nothing. Either
; way it keeps the feed's cadence, which is the reason it runs at all.
mvf_idle:
        ld   a,(G_TICKS)
        or   a
        ret  z
        ld   ix,G_IDLEV
        ld   a,(G_STORE)
        ld   (G_SEG_L),a
        call ms_bind            ; the shift under this pass just became IDLE
        ; A silent pass is one segment as far as the VOICE is concerned — there
        ; is no voice — but the RING's edges still bound it (§5.1.2), and it
        ; still carries the feed, so it walks both cursors. Running it as one
        ; 255-tick segment wrapped `inc l` inside its own page and wrote over
        ; the samples the feed had not read yet.
mvf_idle_seg:
        ld   a,(G_TICKS)
        or   a
        ret  z
        ld   b,a
        call feed_one           ; the silent pass's segments too
        call mvf_ringcap
        push bc
        ld   a,(G_IDX)
        ld   l,a
        ld   a,(G_STORE)
        call mix_seg
        ld   a,l
        ld   (G_IDX),a
        pop  bc
        ld   a,(G_TICKS)
        sub  b
        ld   (G_TICKS),a
        ld   a,(G_IDX)
        or   a
        jr   nz,mvf_idle_feed
        ld   a,(G_MIXP)
        xor  RING_PAGE
        ld   (G_MIXP),a
mvf_idle_feed:
        call feed_wrap
        jr   mvf_idle_seg

; feed_wrap: take the feed cursor back to the ring's base if it has reached the
; top. mvf_ringcap guarantees a segment can only leave it AT the top, never
; past, so this is a test and not arithmetic. Preserves DE and the live file;
; clobbers A and HL, which every call site already rebuilds.
;
; The HIGH BYTE alone answers it. The ring is 512-aligned at RING_BUF and the
; cursor can only be RING_BUF..RING_TOP, so `H == RING_TOP>>8` happens at
; exactly one address. That is the whole routine: 47 cycles against the 86 a
; 16-bit `sbc hl,de` cost, ~17 times a frame — and the wrap itself fires once
; per 512 samples, so essentially all of those calls only ask the question.
feed_wrap:
        push iy
        pop  hl
        ld   a,h
        cp   RING_TOP>>8
        ret  nz
        ld   iy,RING_BUF
        ret

; ---------------------------------------------------------------------------
; plan_next: G_PLANR = ticks to this voice's next logical break, from the slot's
; segment plan (§6.3.1). Zero when the run is spent — a starved frame carries no
; plan, and a run is bounded — and mvf_seg then derives the bound itself.
;
; Clobbers A and HL. DE (the live pointer) and C (the live increment) are the
; register file's and are untouched.
; ---------------------------------------------------------------------------
plan_next:
        xor  a
        ld   (G_PLANR),a
        ld   hl,G_PLANL
        ld   a,(hl)
        or   a
        ret  z                  ; run spent: mvf_seg derives its own bound
        dec  (hl)
        ld   hl,(G_PLANC)
        ld   a,(hl)
        inc  hl
        ld   (G_PLANC),hl
        ld   (G_PLANR),a
        ret

; ---------------------------------------------------------------------------
; mvf_ringcap: shorten B so this segment cannot walk either ring cursor over an
; edge (§5.1.2).
;
;   the MIXER's cursor is (G_MIXP:G_IDX) and advances one per tick, so its page
;   has 256 - G_IDX ticks left in it;
;   the FEED's is IY and advances one per PCM_PASSES ticks, so the ring's top is
;   at least 3 x (RING_TOP - IY) ticks away — a lower bound, because the
;   remainder ticks of a segment carry no emit at all.
;
; Both are compared in 8 bits where they can be: the mixer's page always fits,
; and the feed's distance only matters when it is under 256/3.
; Preserves DE and the alternate set; B is the segment length in and out.
mvf_ringcap:
        push hl
        ld   a,(G_IDX)
        neg                     ; 256 - index, and 0 means a full page
        jr   z,mvf_rc_feed
        cp   b
        jr   nc,mvf_rc_feed
        ld   b,a
mvf_rc_feed:
        push de
        push iy
        pop  hl
        ld   de,RING_TOP
        ex   de,hl
        or   a
        sbc  hl,de              ; HL = samples before the feed leaves the ring
        pop  de
        ld   a,h
        or   a
        jr   nz,mvf_rc_done     ; >= 256 samples away: nothing can reach it
        ld   a,l
        ; SAMPLES -> TICKS, and the factor is PCM_PASSES: the feed advances one
        ; per PCM_PASSES ticks. This was `add a,a / add a,l` (x3) written when
        ; the pass count was three, and it is the one place the count is baked
        ; into hand-written code rather than read from the equ — so the mixer's
        ; pass count moving to two made a segment overrun the ring's top and the
        ; DAC diverge at exactly sample 511, the wrap. build-engine.mjs asserts
        ; PCM_PASSES = 2 against this site.
        add  a,a                ; x2 = ticks, and a carry means far enough
        jr   c,mvf_rc_done
        cp   b
        jr   nc,mvf_rc_done
        or   a
        jr   nz,mvf_rc_cap
        inc  a                  ; forced progress; the wrap lands next segment
mvf_rc_cap:
        ld   b,a
mvf_rc_done:
        pop  hl
        ret

; ---------------------------------------------------------------------------
; mvf_wincap: shorten B to what is left below the ROM window top.
;
;   in    B = the segment so far, DE = the live pointer, PV_KSH the voice's
;         shift bound
;   out   B = min(B, (65536 - ptr) >> KSH), never 0
;
; Only called when the pointer is within one pass's reach of the top, which is
; a handful of segments per sample, not per frame.
; ---------------------------------------------------------------------------
mvf_wincap:
        push bc                 ; C is the live increment
        xor  a
        ld   l,a
        ld   h,a
        sbc  hl,de              ; HL = 65536 - ptr (ptr >= WINDOW, so never 0)
        ld   a,(ix+PV_KSH)
        or   a
        jr   z,mwc_have
        ld   b,a
mwc_sh:
        srl  h
        rr   l
        djnz mwc_sh
mwc_have:
        ld   a,h
        or   a
        jr   nz,mwc_keep        ; >= 256 ticks of window: nothing to cap
        ld   a,l
        or   a
        jr   nz,mwc_cmp
        inc  a                  ; forced progress, as the derived bound does
mwc_cmp:
        pop  bc
        cp   b
        ret  nc
        ld   b,a
        ret
mwc_keep:
        pop  bc
        ret

; ---------------------------------------------------------------------------
; latch_bank: HL = 9-bit ROM bank for the 0x8000 window. The Mega Drive bank
; register is a shift register — nine writes of bit 0, LSB first.
; ---------------------------------------------------------------------------
; The register is write-only, so the engine remembers what it last put there.
; Every voice latches its bank at pass entry and every window crossing latches
; again — but the samples of a song normally sit in ONE bank, so nearly all of
; those are re-latching what is already there, at 414 cycles a time out of a
; frame that does not have them.
latch_bank:
        ld   a,(G_BANKL)
        cp   l
        jr   nz,lb_set
        ld   a,(G_BANKL+1)
        cp   h
        ret  z                  ; already latched
lb_set:
        ld   (G_BANKL),hl
        ld   b,9
lb_loop:
        ld   a,l
        ld   (BANK_REG),a
        srl  h
        rr   l
        djnz lb_loop
        ret

; ---------------------------------------------------------------------------
; ym_write0: C = register, B = value, YM port 0. Used only for $2B; everything
; else on the chip comes from a slot.
; ---------------------------------------------------------------------------
ym_write0:
        call ym_busy0
        ld   a,c
        ld   (YM_ADDR0),a
        call ym_busy0
        ld   a,b
        ld   (YM_DATA0),a
        ret

        include "mixer.z80"

; ===========================================================================
; COLD CODE — above the sample ring (driver.md §5.2)
;
; Everything below $1300 is what the frame runs; the header sits there and
; cannot move, so that is the ceiling for the hot code. What runs ONCE a frame
; or once a boot does not have to be under it: $1C00..$1EFF is free (the ring
; ends at $1BFF, the stack tops at $1F00), and the uploaded image simply spans
; the gap. That is safe because the host uploads BEFORE the Z80 boots and writes
; H_SMPBANK after it — the only header field it owns.
; ===========================================================================
CODE_END:
        org  $1c00
; pcm_pad: G_PAD — what one IDLE iteration holds to, in 16-cycle units.
;
; The sounding copies are already at or past the sample period, so ALL of a
; frame's slack lives in the silent passes; the pad is what hands it to them
; instead of leaving the frame to end early and hold. How much there is depends
; on what else the frame is doing, and every term is known here, at frame start:
; the chunk, each pass's shift, and the slot's write count.
;
; Every approximation rounds the pad DOWN, on purpose. An under-padded frame
; bunches its samples slightly inside a Timer B group, which is second-order
; (measured: a few dB at 3x the frame rate, no frame-rate sidebands). An
; over-padded one loses its vblank, which is a hiccup.
;
;   BUDGET - writes x 128 - the three passes' unpadded cost
;   ------------------------------------------------------  , floored
;            896 x idle passes  (taken as a shift)
;
; The divide is a shift by 10, 11 or 12 for one, two or three silent passes:
; 896 -> 1024, 1792 -> 2048, 2688 -> 4096. Each rounds the pad down.
pcm_pad:
        ; ANY voice sounding and the answer is the floor, so do not spend ~1,500
        ; cycles proving it. One sounding pass plus two silent ones already
        ; exceeds PCM_BUDGET at every shift — the cheapest sounding pass is
        ; 26,390 against a budget of 42,000 with 22,156 of silent passes under
        ; it — so the subtraction below can only go negative and fall through to
        ; pp_pad_min. build-engine.mjs asserts that from pass_cost_tab and fails
        ; the build if it ever stops holding, which is the only way this shortcut
        ; can go wrong.
        ;
        ; It reads as slack that vanished, and it is: the pad was sized when an
        ; emit was priced at 49 cycles. Pricing it at its real 118 (gen-mixer's
        ; EMIT_CYCLES) took every spare cycle with it, and a frame with a voice
        ; in it has nothing left to hand the silent passes. Only the wholly
        ; silent frame still has a choice to make, and it has the budget to.
        ld   a,(G_ACTM)
        or   a
        jr   nz,pp_pad_floor
        push bc
        push de
        push ix
        ; The slot's writes are NOT charged: they carry samples now (feed_one in
        ; the consume loop), so their cycles are emission time and charging them
        ; here would take the same cycles away twice.
        ld   hl,PCM_BUDGET
        ; each pass costs its own shift if it sounds, IDLE if it does not
        ld   c,0                ; silent passes so far
        ld   b,0                ; voice index
pp_cost:
        push bc
        ld   c,b
        call pp_sounding_at     ; NZ if voice C was sounding at frame start
        jr   z,pp_cost_idle
        push hl
        ld   a,b
        call voice_ptr
        ld   a,(ix+PV_SHIFT)
        pop  hl
        jr   pp_cost_have
pp_cost_idle:
        pop  bc
        inc  c
        push bc
        ld   a,PCM_IDLE_SH
pp_cost_have:
        add  a,a                ; word table
        ld   e,a
        ld   d,0
        push hl
        ld   hl,pass_cost_tab
        add  hl,de
        ld   e,(hl)
        inc  hl
        ld   d,(hl)
        pop  hl
        or   a
        sbc  hl,de
        pop  bc
        inc  b
        ld   a,b
        cp   PCM_VOICES
        jr   c,pp_cost
        ; Nothing silent to give it to, or nothing left to give: the floor is
        ; 1, because the pad loop counts DOWN and zero would be 256.
        ld   a,c
        or   a
        jr   z,pp_pad_min       ; three sounding voices: no slack anywhere
        bit  7,h
        jr   nz,pp_pad_min      ; already over budget
        ; >> (9 + silent passes): 896 -> 1024, 1792 -> 2048, 2688 -> 4096, each
        ; rounding the pad down.
        ld   a,9
        add  a,c
        ld   b,a
pp_pad_sh:
        srl  h
        rr   l
        djnz pp_pad_sh
        ld   a,h
        or   a
        jr   nz,pp_pad_max      ; >= 256 units
        ld   a,l
        cp   PCM_IDLE_PAD+1
        jr   c,pp_pad_store
pp_pad_max:
        ld   a,PCM_IDLE_PAD     ; never longer than the sample period itself
        jr   pp_pad_store
pp_pad_min:
        ld   a,1
pp_pad_store:
        or   a
        jr   nz,pp_pad_st
        inc  a
pp_pad_st:
        ld   (G_PAD),a
        pop  ix
        pop  de
        pop  bc
        ret

; The floor, reached without touching a register: the pad loop counts DOWN, so
; zero would be 256 and 1 is the shortest hold there is.
pp_pad_floor:
        ld   a,1
        ld   (G_PAD),a
        ret

