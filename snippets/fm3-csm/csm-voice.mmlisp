; CSM as a voice. Timer A re-keys FM3 at an audio rate and every operator
; rings, then dies away, at the note times its own ML. The buzz rate is the
; pitch you hear; the four ringing frequencies are the formants, and the
; formants are the vowel. So a vowel is a note (the base) plus four MLs, the
; melody lives on fm3-csm-rate, and the noise channel adds the consonants.
; A fast release (RR) keeps each ring short, which widens the formants from a
; whistle into a vowel. A syllable is one parametric def over the three
; tracks, so the song is written as its lyrics. Sings "a i u e o", then
; Sakura Sakura.

; four carriers; the level falls with each formant, like a voice
(def-fm vox init-fm :alg 7 :fb 0
  :ar1 31 :rr1 13 :tl1 4
  :ar2 31 :rr2 14 :tl2 10
  :ar3 31 :rr3 15 :tl3 18
  :ar4 31 :rr4 15 :tl4 26)

; vowel = base note x ML per operator (formants F1-F4, in Hz)
(def ah :oct 4 :ml1 2 :ml2 3 :ml3 7  :ml4 9  f+) ;  740 1110 2590 3330
(def ee :oct 4 :ml1 1 :ml2 8 :ml3 11 :ml4 13 c+) ;  277 2217 3047 3600
(def oo :oct 4 :ml1 1 :ml2 3 :ml3 8  :ml4 11 d)  ;  294  881 2350 3230
(def eh :oct 4 :ml1 2 :ml2 7 :ml3 9  :ml4 12 c)  ;  523 1831 2355 3140
(def oh :oct 4 :ml1 2 :ml2 3 :ml3 9  :ml4 12 c+) ;  554  831 2493 3325

; consonants: a hiss for s, a click for k and t, a softer one for g
(def sh :mode white0 (macro :vel [7 9 9 9 8 7 5 3 1 0]) c)
(def kh :mode white1 (macro :vel [13 8 3 0]) c)
(def gh :mode white1 (macro :vel [8 4 0]) c)

; a syllable: its length, its vowel, its pitch (a Timer A rate) and its
; consonant (_ for none). It swells in from a lower fader: the dip at each
; onset is what separates syllables (a CSM note keys nothing, so there is no
; attack of its own, and a :vel macro would not run on the driver). Two
; pitches, or an octave step, go as one in an empty let.
(def (sing len vowel pitch cons)
  (fm3-csm :len len :vol (linear 14..31 :len 16) vowel)
  (fm3-csm-rate :len len pitch)
  (noise :len len cons))

(fm3-csm vox :tempo 80)
(fm3-csm-rate :oct 3 (glide 32))                         ; glide slides between the rates

(sing 4 ah a _) (sing 4 ee a _) (sing 4 oo a _) (sing 4 eh a _) (sing 1 oh a _)  ; a i u e o
(sing 4 ah a sh) (sing 4 oo a kh) (sing 2 ah b _)                ; sa ku ra
(sing 4 ah a sh) (sing 4 oo a kh) (sing 2 ah b _)                ; sa ku ra
(sing 4 ah a _) (sing 4 oh b _) (sing 4 ee (let [] > c <) _) (sing 4 oh b _)   ; ya yo i no
(sing 4 oh a sh) (sing 4 ah (let [] b8 a8) _) (sing 2 ah f _)                   ; so ra wa
(sing 4 ee e _) (sing 4 ah c _) (sing 4 ah e kh) (sing 4 oo f sh)               ; mi wa ta su
(sing 4 ah e kh) (sing 4 ee (let [] e8 c8) gh) (sing 2 ee (let [] < b >) _)     ; ka gi ri
(sing 4 ah a sh) (sing 4 oo a kh) (sing 2 ah b _)                ; sa ku ra
(sing 4 ah a sh) (sing 4 oo a kh) (sing 2 ah b _)                ; sa ku ra
(sing 4 ee e _) (sing 4 ee f _) (sing 4 oo (let [] b8 a8) _) (sing 4 ah f kh) (sing 1 oo e _)  ; mi ni yu ka n
