mix_add_s0:
mix_add_s0_lp:
        ex   af,af'            ; A' is the gate phase (1..GROUP); see gatePrologue
        dec  a
        jr   nz,gt52            ; not this sample's turn to wait
        call gate_wait         ; hold for Timer B; returns A = PCM_GROUP
gt52:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
        xor  $80               ; the ring is signed, the DAC is not
        ld   (YM_DATA0),a      ; $2A, fed blind
        inc  iy                ; wraps at a SEGMENT boundary, never here
        ld   a,(de)             ; sample
        add  a,(hl)
        jp   pe,ov53
dn54:
        ld   (hl),a
        inc  l
        exx
        add  hl,de             ; frac += incFrac
        exx                    ; flag-transparent: the carry survives
        ld   a,e
        adc  a,c               ; ptr += incInt + frac carry
        ld   e,a
        jr   nc,np55
        inc  d
np55:
        ld   a,(de)             ; sample
        add  a,(hl)
        jp   pe,ov56
dn57:
        ld   (hl),a
        inc  l
        exx
        add  hl,de             ; frac += incFrac
        exx                    ; flag-transparent: the carry survives
        ld   a,e
        adc  a,c               ; ptr += incInt + frac carry
        ld   e,a
        jr   nc,np58
        inc  d
np58:
        dec  b
        jp   nz,mix_add_s0_lp
        ret
ov53:
        jp   m,ov53_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn54
ov53_hi:
        ld   a,$7f
        jp   dn54
ov56:
        jp   m,ov56_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn57
ov56_hi:
        ld   a,$7f
        jp   dn57
