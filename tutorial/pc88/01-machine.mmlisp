; The PC-8801 with Sound Board II: a YM2608 is six FM channels (fm1–fm6), the
; SSG's three squares (sqr1–sqr3), a ROM rhythm (rhythm1–rhythm6) and a
; sample channel (pcm1). The next steps play what only it has.
(def-score :target pc88)
(import "presets/gm/set.mmlisp")
(import "presets/rx5/set.mmlisp")
(fm1 gm-ep1 #top c4 e4 g4 e4 (go top))
(fm2 gm-bass-finger :oct 2 #top c2 g2 (go top))
(sqr1 :oct 5 :vel 10 #top (x 2 c e g e) (go top))
(rhythm1 kick #top c4 c4 c4 c4 (go top))
(rhythm2 hat #top (x 8 c) (go top))
