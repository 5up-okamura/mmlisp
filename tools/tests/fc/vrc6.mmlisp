; fc: the VRC6 cartridge beside the 2A03 — its two pulses (:duty to the
; nearest of 1-8 sixteenths, 12 sounding as its mirror 4; a duty macro)
; and its saw (:vel as the rate: 13.25 its clean top, 42; 15 its 63,
; wrapping; a fade). Its channels are left out of the VGM.
(def-score :target fc :title "fc vrc6")
(sqr1 :tempo 140 :len 8 c e g > c < g e c e |)
(sqr3 :len 8 :duty 1 e g > c e < :duty 12 g e c e |)
(sqr4 :len 4 (macro :duty [1 2 4 8]) g1 |)
(saw1 :len 4 :oct 2 :vel 13.25 c :vel 15 e (glide 8) g (macro :vel (linear 15..0 :len 4)) c |)
