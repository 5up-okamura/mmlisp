(import "../../presets/waveforms/waveforms.mmlisp")
(def title "NES / VRC6 FM tone audition")
; Each patch: low note, middle note, high note, then a short phrase.
(fm1 :tempo 120 :vel 15 :vol 31 :len 4
  ; wave-square
  wave-square :oct 3 c _ :oct 4 c _ :oct 5 c _ :oct 4 :len 8 c e g > c < g e c _ :len 4
  ; wave-pulse-25
  wave-pulse-25 :oct 3 c _ :oct 4 c _ :oct 5 c _ :oct 4 :len 8 c e g > c < g e c _ :len 4
  ; wave-pulse-12-approx
  wave-pulse-12-approx :oct 3 c _ :oct 4 c _ :oct 5 c _ :oct 4 :len 8 c e g > c < g e c _ :len 4
  ; wave-triangle
  wave-triangle :oct 3 c _ :oct 4 c _ :oct 5 c _ :oct 4 :len 8 c e g > c < g e c _ :len 4
  ; wave-saw
  wave-saw :oct 3 c _ :oct 4 c _ :oct 5 c _ :oct 4 :len 8 c e g > c < g e c _ :len 4
)
