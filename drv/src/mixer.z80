        inc  iy                ; wraps at a SEGMENT boundary, never here
        ld   a,2                ; pace: hold the tick to the sample period
pd116:
        dec  a
        jr   nz,pd116
        ld   a,(de)             ; sample
        sra  a
        sra  a
        sra  a
        sra  a
        ld   (hl),a
        inc  l
        inc  de                ; pre-resampled: one sample per tick
        ld   a,(de)             ; sample
        sra  a
        sra  a
        sra  a
        sra  a
        ld   (hl),a
        inc  l
        inc  de                ; pre-resampled: one sample per tick
        dec  b
        jp   nz,mix_firstnr_s4_lp
