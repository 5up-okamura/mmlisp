; :shuffle R swings pairs of the :shuffle-base length (a sixteenth unless
; set): the first of each pair takes R percent of the pair's length (50
; would be straight). It is set per track: here the whole band swings its
; eighths at 66. Delete the :shuffle options to hear it straight.
(import "presets/gm/set.mmlisp")

(fm1 :shuffle 66 :shuffle-base 8 :tempo 132 :oct 4 :len 8 gm-ep1
  e g a g e g a > c < b a g e d e g _)
(fm2 :shuffle 66 :shuffle-base 8 :oct 1 :len 8 gm-bass-acoustic
  c _ c e g _ g a b- _ b- a g _ g e)
