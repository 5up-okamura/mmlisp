; A song: voices, a def, glide, pan, drums, and every track looping two
; bars. File > Export > WAV writes what you hear, VGM the chip's own writes
; for VGM players, and File > Share a link that opens the score. Change it
; and make it yours.
(def-score :title "First Song" :pcm-voices 1)
(import "presets/gm/set.mmlisp")
(import "presets/tr808/set.mmlisp")
(def riff c e g e)
(fm1 gm-vibes :pan left #top riff riff riff (glide 16) g4 a4 (glide none) (go top))
(fm2 gm-bass-finger :pan right :oct 2 #top c2 g2 f2 g2 (go top))
(pcm1 #top (x 4 kick c _ snare c _) (go top))
