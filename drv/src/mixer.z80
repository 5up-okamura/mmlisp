mix_addnr_s4:
mix_addnr_s4_lp:
        ex   af,af'            ; A' is the gate phase (1..GROUP); see gatePrologue
        dec  a
        jr   nz,ep154          ; PATCHED: ep154 at unity, ea154 under a shift
        call gate_wait         ; hold for Timer B; returns A = PCM_GROUP
ea154:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ms154:
        jr   ex154             ; master chain, slot 0 — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        jr   ex154               ; …and into the tail the plain copy shares
ep154:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ex154:
        xor  $80               ; the ring is signed, the DAC is not
        ld   (YM_DATA0),a      ; $2A, fed blind
        inc  iy                ; wraps at a SEGMENT boundary, never here
        ld   a,(de)             ; sample
        sra  a
        sra  a
        sra  a
        sra  a
        add  a,(hl)
        jp   pe,ov155
dn156:
        ld   (hl),a
        inc  l
        inc  de                ; baked at this note: one sample per tick
        ld   a,(de)             ; sample
        sra  a
        sra  a
        sra  a
        sra  a
        add  a,(hl)
        jp   pe,ov157
dn158:
        ld   (hl),a
        inc  l
        inc  de                ; baked at this note: one sample per tick
        dec  b
        jp   nz,mix_addnr_s4_lp
