; M4 gate: a macro value may never BE the hold sentinel (driver.md §13).
;
; `_` in a macro encodes as 0x8000 (i16) or 0x80 (i8) and both players decode
; it as "advance, write nothing". NOTE_PITCH's range bottoms out at -32768 —
; exactly that i16 sentinel — so a pitch macro driven to its floor used to stop
; writing instead of holding the floor, silently and with no diagnostic.
;
; fm1 authors the floor exactly; fm2 authors past it, so the clamp produces it.
; Both must keep writing $A4/$A0 every step. The floor is nonsense musically
; (-327 semitones) but a computed or scaled macro reaches it by arithmetic,
; which is why the encoder, not the author, has to hold the line.
(def voi :alg 7 :fb 0
  :ar1 31 :dr1 0 :sr1 0 :rr1 6 :sl1 0 :tl1 20 :ks1 0 :ml1 1 :dt1 0 :am1 0 :ssg1 0
  :ar2 31 :dr2 0 :sr2 0 :rr2 6 :sl2 0 :tl2 20 :ks2 0 :ml2 1 :dt2 0 :am2 0 :ssg2 0
  :ar3 31 :dr3 0 :sr3 0 :rr3 6 :sl3 0 :tl3 20 :ks3 0 :ml3 1 :dt3 0 :am3 0 :ssg3 0
  :ar4 31 :dr4 0 :sr4 0 :rr4 6 :sl4 0 :tl4 20 :ks4 0 :ml4 1 :dt4 0 :am4 0 :ssg4 0)
(fm1 :tempo 120 voi :oct 4 :len 2 (macro :pitch [-32768 -32768] :step 8f) c c)
(fm2 voi :oct 4 :len 2 (macro :pitch [-40000 -40000] :step 8f) c c)
