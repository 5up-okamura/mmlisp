; Experimental: three baked notes of the 1.5-second fixture exceed 32 KiB.
; pcm1/pcm2 overlap samples whose bank-relative addresses can be identical.
(def-score :pcm-voices 2)
(def-pcm bank :file "pcmbank.wav" :loop-start 150ms :loop-end 450ms)
(fm1 :tempo 120 :oct 4 :len 8 :vel 10
  c e g c c e g c c e g c c e g c c e g c)
(pcm1 bank :tempo 120 :oct 4 :len 2 :mode loop :vel 12
  c e g :master 25 c :master 31 e)
(pcm2 bank :tempo 120 :oct 4 :len 2 :mode loop :vel 10
  g c e g c)
