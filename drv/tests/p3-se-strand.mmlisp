; START_TRACK over a channel an effect holds must not strand the part the
; effect displaced (driver.md §2.5). The effect takes fm1 from the BGM at 40;
; at 55 the part of effect `other` (track 2, on fm1) is started as a TRACK,
; which evicts the effect — and the suspended BGM must be released, not left
; waiting for a restore that would one day land over a stranger.
(def-fm v :alg 7 :fb 0 :ar1 31 :tl1 20 :ml1 1 :ar2 31 :tl2 20 :ml2 1 :ar3 31 :tl3 20 :ml3 1 :ar4 31 :tl4 8 :ml4 1)
(def-fm w :alg 7 :fb 0 :ar1 31 :tl1 4 :ml1 5 :ar2 31 :tl2 4 :ml2 5 :ar3 31 :tl3 4 :ml3 5 :ar4 31 :tl4 2 :ml4 5)
(def-fm u :alg 7 :fb 3 :ar1 31 :tl1 12 :ml1 2 :ar2 31 :tl2 12 :ml2 2 :ar3 31 :tl3 12 :ml3 2 :ar4 31 :tl4 6 :ml4 2)
(fm1 :tempo 120 v :oct 4 :len 1 :vel 12 c c c c)   ; track 0
(def-se hit :prio 5 (fm1 w :oct 6 :len 8 :vel 15 g g))   ; track 1
(def-se other (fm1 u :oct 5 :len 1 :vel 13 e e))       ; track 2
