; gb: the wave's three levels and silence, a def-wave named under a note, and
; the same wave named again (no load), and :pan on every kind of channel.
(def-score :target gb :title "gb wave")
(def-wave saw :wave [-128 -112 -96 -80 -64 -48 -32 -16 0 16 32 48 64 80 96 112 127 112 96 80 64 48 32 16 0 -16 -32 -48 -64 -80 -96 -112])
(def-wave tri2 :wave [127 127 127 127 127 127 127 127 -128 -128 -128 -128 -128 -128 -128 -128 127 127 127 127 127 127 127 127 -128 -128 -128 -128 -128 -128 -128 -128])
(wave :tempo 140 :len 4 :oct 3 :wave saw c :vel 12 e :vel 8 g :vel 15 :wave tri2 c :wave tri2 e _ :vol 0 c :vol 31 :wave saw c |)
(sqr1 :len 2 :pan -1 c :pan 1 e :pan 0 g c |)
(noise :len 2 :oct 2 :pan 1 c :pan -1 e :pan 0 g c |)
