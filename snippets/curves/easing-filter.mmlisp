; A "filter sweep" on FM: the modulator's TL sets how bright the note is, so a
; curve on it opens and closes the sound. Inline, a curve is a timeline sweep
; across notes; in a (macro ...) it restarts at every key-on.
(import "presets/waveforms/set.mmlisp")

(fm1 :tempo 128 :oct 2 :len 16 acid-saw
  ; one sweep over two bars, independent of the notes
  :tl3 (ease-inout-sine 60..10 :len 2/1)
  (x 2 c c > c < c c > c < c c e- c > c < c c g c)
  ; per-note envelope: every note snaps open and closes
  (macro :tl3 (ease-out-expo 10..60 :len 8))
  (x 2 c c > c < c c > c < c c e- c > c < c c g c))
