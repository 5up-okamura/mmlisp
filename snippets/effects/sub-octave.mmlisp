; Sub-octave: an ML of 0 is half the note's frequency, an octave down. In
; this bass, op3 feeds op4 and op1 feeds op2 (alg 4, two pairs); the variant
; silences op3 and sets op4 to ML 0, so the second pair becomes a pure sine
; an octave under the first. The same line plain, then with the sub.
(def-fm bass :alg 4 :fb 5
  :ar1 31 :dr1 10 :sl1 4 :tl1 28 :ml1 1
  :ar2 31 :dr2 6  :sl2 3 :tl2 6  :rr2 8
  :ar3 31 :dr3 10 :sl3 4 :tl3 34 :ml3 2
  :ar4 31 :dr4 6  :sl4 3 :tl4 10 :rr4 8)
(def-fm bass-sub bass :tl3 127 :ml4 0 :tl4 4 :dr4 2)

(def line :len 8 c _ c e-  _ f g _  b- _ g f  e- c < b- > c)

(fm1 :tempo 200 :oct 3
  bass (x 2 line)
  bass-sub (x 2 line))
