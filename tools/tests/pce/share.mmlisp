; pce: one channel under three names — wave5, noise5 and pcm5 all written.
; Where their notes meet, DDA outranks the noise and the noise the wave (a
; note starting under a higher one is dropped, one sounding is cut); a
; :prio on wave6 puts it over pcm6. Channel 5's names loop together, each
; on its own loop, and the tempo moves inside it: the loop is 1.857 s.
(def-score :target pce :title "pce share")
(def-pcm blip :file "wav/blip.wav")
(def-wave saw :wave (saw -128..127))
(wave5 #top :tempo 120 saw :len 4 c c :tempo 140 c c | (go top))
(pcm5 :len 8 #top blip _ c _ _ c c _ _ | (go top))
(noise5 :len 2 :oct 3 #top _ c | (go top))
(wave6 :prio 1 saw :len 2 e _ |)
(pcm6 :len 4 blip c c c c |)
