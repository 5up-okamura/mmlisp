; P3 gate: an effect takes CH3 WHOLE (driver.md §2.5). CH3's operator mode and
; CSM are chip-wide, so an effect with a part on fm3, fm3-1…fm3-4 or fm3-csm
; suspends every song part on CH3 and gives back the mode, the Timer A period,
; the patch, the levels and the held notes at its end. The song here plays CH3
; in NORMAL mode; p3-se-ch3-op is the same against a song in operator mode.
;   0 chord  operator mode: a patch part and three operators, one chord
;   1 buzz   CSM: a formant buzz with its rate swept, priority 5
;   2 blip   normal CH3, priority 3 — fired while buzz holds CH3: dropped
; (p3-se-ch3.cmds.json: chord at 30, buzz at 90, blip at 100, chord at 160.)
(def-fm pad :alg 4 :fb 2
  :ar1 20 :dr1 4 :sr1 1 :rr1 6 :sl1 2 :tl1 28 :ml1 1 :ks1 0 :dt1 0
  :ar2 22 :dr2 5 :sr2 1 :rr2 6 :sl2 2 :tl2 10 :ml2 1 :ks2 0 :dt2 0
  :ar3 20 :dr3 4 :sr3 1 :rr3 6 :sl3 2 :tl3 30 :ml3 2 :ks3 0 :dt3 0
  :ar4 22 :dr4 5 :sr4 1 :rr4 6 :sl4 2 :tl4 8 :ml4 1 :ks4 0 :dt4 0)
(def-fm kit :alg 7 :fb 0
  :ar1 31 :dr1 6 :sr1 1 :rr1 6 :sl1 2 :tl1 10 :ml1 2 :ks1 0 :dt1 0
  :ar2 31 :dr2 8 :sr2 2 :rr2 8 :sl2 2 :tl2 10 :ml2 1 :ks2 0 :dt2 0
  :ar3 31 :dr3 6 :sr3 1 :rr3 6 :sl3 2 :tl3 10 :ml3 4 :ks3 0 :dt3 0
  :ar4 31 :dr4 9 :sr4 2 :rr4 9 :sl4 3 :tl4 10 :ml4 1 :ks4 0 :dt4 0)
(def-fm buzz :alg 7 :fb 0
  :ar1 31 :dr1 10 :sr1 4 :rr1 8 :sl1 4 :tl1 20 :ml1 3 :ks1 0 :dt1 0
  :ar2 31 :dr2 12 :sr2 5 :rr2 9 :sl2 5 :tl2 18 :ml2 5 :ks2 0 :dt2 0
  :ar3 31 :dr3 10 :sr3 4 :rr3 8 :sl3 4 :tl3 22 :ml3 7 :ks3 0 :dt3 0
  :ar4 31 :dr4 14 :sr4 6 :rr4 10 :sl4 6 :tl4 8 :ml4 2 :ks4 0 :dt4 0)

(fm1 :tempo 120 pad :oct 4 :len 1 :vel 12  c e g c)   ; track 0
(fm3 pad :oct 3 :len 1 :vel 13 :vol 26  e g b e)      ; track 1 — CH3, normal mode

(def-se chord :prio 5
  (fm3 kit :vol 28)
  (fm3-1 :oct 5 :len 4  c e)
  (fm3-2 :oct 5 :len 4  e g)
  (fm3-3 :oct 5 :len 4  g b))
(def-se buzz :prio 5
  (fm3-csm buzz :oct 3 :len 4 :vel 13 :csm-rate 440  c :csm-rate (linear 440..880 :len 4) c))
(def-se blip :prio 3
  (fm3 kit :oct 6 :len 16  c e))
