; Building a song from sections. A def that holds channel forms is a section:
; its name, written at the top level, puts every channel's part in place at
; once, so the song is arranged in one line and the channels stay in step.
; Inside a section the flow forms do what they do on a track: (x 2 ...) with
; (break) is a first and second ending (the second pass stops at the break
; and goes on to what follows), #label ... (go label 2) repeats a part.
(import "presets/gm/set.mmlisp")

(def intro
  (fm1 :tempo 132 :oct 5 gm-lead-calliope :len 2 g e)
  (fm2 :oct 1 gm-bass-finger :len 4 c g c g))

; verse, turnaround, verse again, then straight on
(def verse
  (fm1 (x 2 :len 8 e d c d e e e _  d d d _ e g g _
         (break) e d c d e e e e  d d e d :len 2 c))
  (fm2 (x 2 :len 4 c g c g  g d g d
         (break) c g c g  g d :len 2 c)))

; the chorus plays twice
(def chorus
  (fm1 #again :len 8 c c g g a a :len 4 g  :len 8 f f e e d d :len 4 c (go again 2))
  (fm2 #again :len 4 c c f c  f c g c (go again 2)))

(def ending
  (fm1 :len 1 c)
  (fm2 :len 1 c))

intro verse chorus ending
