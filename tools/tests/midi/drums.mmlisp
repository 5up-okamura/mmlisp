; :target midi — the drums: channel 10 as four tracks, so hits sound together;
; the kit's roles built in, at their GM keys.
(def-score :target midi :title "midi drums")
(drums :tempo 132 :len 4 #top kick c snare c kick c snare :vel 12 c (go top))
(drums2 :len 8 #top hat c c c c c c hat-open c hat c (go top))
(drums3 :len 1 #top crash c (go top))
(ch1 gm-bass-finger :oct 2 :len 8 #top c c g g a a g g (go top))
