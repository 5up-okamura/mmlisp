; msx: the PSG's hardware envelope — a saw buzzer on the track's notes, a
; triangle's period halved, a slur that runs on, a fixed rate (the later
; track's, which the period the channels share takes) swept, and a channel
; back on its own level.
(def-score :target msx :title "msx env")
(sqr1 :tempo 120 :env 8 :env-rate note :mode env :oct 2 :len 8
  c c g g a ~ g e _ :env 14 c c > c < c |)
(sqr2 :len 4 _ _ _ _
  :env 0 :env-rate 20 :mode tone c e :env-rate (linear 20..80 :len 2) g e
  :env none :mode tone c e g e |)
