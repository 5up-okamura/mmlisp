; brown noise is a random walk: it wanders instead of jumping, like an old
; synth whose tuning drifts. Two channels play the same line with different
; :seed, so the unison beats slowly against itself. A macro restarts at every
; note, so the drift lives inside each note: the long notes drift furthest.
(import "presets/gm/set.mmlisp")

(def line :len 2 c e g f e d c1)

(fm1 :tempo 96 :oct 4 gm-synbrass1 :pan left
  (macro :pitch (brown -14..14 :len 2 :seed 1))
  line)
(fm2 :oct 4 gm-synbrass1 :pan right :vel 13
  (macro :pitch (brown -14..14 :len 2 :seed 2))
  line)
