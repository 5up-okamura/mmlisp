; Song-wide sweeps gate (driver.md §4): :master, :lfo-rate and the def-val
; slots sweep in their own slots, owned by no channel. fm1 starts a :master
; fade and a :swell sweep, then an effect takes fm1 at frame 30 — both must
; run on. sqr1 sweeps a public slot that fm2 reads; the host writes that slot
; at frame 120 (cmds.json), which ends the score's sweep of it. The voice is
; ALG 0, so the slot-fed TL writes land on modulators, clear of :master.
(def-val tone 0 0..60 :public)
(def-val swell 0)

(def-fm pad :alg 0 :fb 0
  :ar1 31 :rr1 6 :tl1 30 :ar2 31 :rr2 6 :tl2 30
  :ar3 31 :rr3 6 :tl3 30 :ar4 31 :rr4 6 :tl4 0)

(def-se zap (fm1 :len 16 pad :oct 6 c e g > c))

(fm2 :tempo 120 pad :oct 3 :len 8 (x 16 :tl2 (+ 10 $tone) :tl3 $swell c))
(fm1 pad :oct 4 :len 16
  :master (linear 31..12 :len 2) :swell (linear 0..40 :len 2) :lfo-rate (linear 1..8 :len 1)
  (x 32 :tl1 (+ 10 $swell) c))
(sqr1 :len 2 :tone (sin :from 0 :to 50 :len 1) _ :tone+ 5 :swell* 0.5 _)
