; A held PCM note can loop part of its sample. :mode loop plays up to
; :loop-end, repeats [:loop-start, :loop-end) while held, then plays out the
; tail. On a track the points move while the note sounds, even as curves:
; tighten the loop to a buzz, then slide it through the sample. Last, a beat
; repeat: the snare's first 32nd looped, then shortened every frame until it
; buzzes, the classic glitch fill.
(import "presets/sfx/set.mmlisp")
(import "presets/tr808/set.mmlisp")

(pcm1 ooo :mode loop :len 1
  :loop-start 50ms :loop-len 16                    c  ; a 16th-note loop
  :loop-len (linear :from 100ms :to 2ms :len 1)    c  ; tighten it to a buzz
  :loop-len 60ms
  :loop-start (linear :from 20ms :to 200ms :len 1) c c ; slide it through
  :mode shot :len 8 kick c _ snare c _ kick c kick c snare c _
  :mode loop :loop-start 0ms :loop-len 32 snare :len 4 c       ; beat repeat
  :loop-len (linear :from 40ms :to 3ms :len 4) c               ; ...to a buzz
  :mode shot :len 2 kick c)
