; P3 gate: an effect's end puts back the PATCH the channel had, as the register
; shadow holds it (driver.md §2.5) — not a voice by number. The song's patch
; here has no VOICE_SET to rebuild from: a partial def-fm (no :ks/:dt), then a
; mid-song :tl1 and :pan. The effect plays a full voice panned the other way.
; (p3-se-patch.cmds.json: hit at 70.)
(def-fm soft :alg 4 :fb 3
  :ar1 20 :dr1 4 :sr1 1 :rr1 6 :sl1 2 :tl1 28 :ml1 1
  :ar2 22 :dr2 5 :sr2 1 :rr2 6 :sl2 2 :tl2 10 :ml2 1
  :ar3 20 :dr3 4 :sr3 1 :rr3 6 :sl3 2 :tl3 30 :ml3 2
  :ar4 22 :dr4 5 :sr4 1 :rr4 6 :sl4 2 :tl4 8 :ml4 1)
(def-fm hit :alg 7 :fb 0
  :ar1 31 :dr1 6 :sr1 1 :rr1 6 :sl1 2 :tl1 10 :ml1 2 :ks1 0 :dt1 0
  :ar2 31 :dr2 8 :sr2 2 :rr2 8 :sl2 2 :tl2 10 :ml2 1 :ks2 0 :dt2 0
  :ar3 31 :dr3 6 :sr3 1 :rr3 6 :sl3 2 :tl3 10 :ml3 4 :ks3 0 :dt3 0
  :ar4 31 :dr4 9 :sr4 2 :rr4 9 :sl4 3 :tl4 10 :ml4 1 :ks4 0 :dt4 0)

(fm1 :tempo 120 soft :oct 4 :len 4 :vel 12 :pan -1  c :tl1 20 e g c g e c e)   ; track 0

(def-se hit :prio 5
  (fm1 hit :pan 1 :oct 5 :len 8  c e g))
