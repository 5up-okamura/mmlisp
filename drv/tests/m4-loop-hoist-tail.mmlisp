; Loop-head VOICE_SET hoist (driver.md §10.1) beside what began before the
; loop. fm1: a macro on op 1's level, whose release tail outlives its note, may
; still be writing it when the loop comes round — the head VOICE_SET stays
; inside to put it back. fm4: a sweep on the level begun before the loop is
; ended by the head VOICE_SET (§10), on the preview as on the driver — it
; hoists. fm2 is the plain case, which hoists. voice-repeat-gate asserts all
; three.

(def-fm lead :alg 4 :fb 3
  :ar1 28 :dr1 6 :sr1 1 :rr1 6 :sl1 2 :tl1 30 :ks1 1 :ml1 2 :dt1 2
  :ar2 31 :dr2 9 :sr2 2 :rr2 8 :sl2 2 :tl2 6 :ks2 0 :ml2 1 :dt2 0
  :ar3 26 :dr3 5 :sr3 1 :rr3 6 :sl3 1 :tl3 34 :ks3 1 :ml3 4 :dt3 -2
  :ar4 31 :dr4 10 :sr4 2 :rr4 9 :sl4 3 :tl4 4 :ks4 0 :ml4 1 :dt4 0)

(fm1 :tempo 150 :oct 4 :len 2 :vel 12
  (macro :tl1 [10 20 30 #rel 40 50 60 70 80 90]) c (macro :tl1 none)
  #loop lead c c
  (go loop))

(fm2 :oct 4 :len 2 :vel 12
  #loop lead c c
  (go loop))

(fm4 :oct 4 :len 2 :vel 12
  :tl1 (linear 60..0 :len 8)
  #loop lead c c
  (go loop))
