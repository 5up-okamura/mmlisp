; M4 gate: a :tl is a VOICED level, so every path that writes $40 composes it
; with the level the channel is playing at (driver.md §7). Both ways of
; changing a patch mid-song used to write the register RAW, which dropped
; vel/vol/master until the next note-on put them back — and on a note that is
; still sounding no next note-on ever comes.
;
; Track 1 (fm1): a whole note at :vol 24 (TL 20 → 39), then a mid-song :tl1.
; It must land at 40 + the same 19 dB, not at 40.
; Track 2 (fm2): the same change on a MODULATOR (alg 4: op2/op4 carry). op1's
; level is modulation depth, not volume, so it stays raw — the rule is the
; channel's carrier set, not "compose everything".
; Tracks 3+ (fm3 special mode): the change arrives as a full voice, which the
; exporter coalesces into one VOICE_SET. Each operator carries its OWN level
; there, so all four compose and the carrier table is not consulted: op1 holds
; one whole note at :vol 24 across the change and must keep its 19 dB.
(def lead (voice :alg 7 :fb 0
  :ar1 31 :dr1 0 :sr1 0 :rr1 6 :sl1 0 :tl1 20 :ks1 0 :ml1 1 :dt1 0 :am1 0 :ssg1 0
  :ar2 31 :dr2 0 :sr2 0 :rr2 6 :sl2 0 :tl2 20 :ks2 0 :ml2 1 :dt2 0 :am2 0 :ssg2 0
  :ar3 31 :dr3 0 :sr3 0 :rr3 6 :sl3 0 :tl3 20 :ks3 0 :ml3 1 :dt3 0 :am3 0 :ssg3 0
  :ar4 31 :dr4 0 :sr4 0 :rr4 6 :sl4 0 :tl4 20 :ks4 0 :ml4 1 :dt4 0 :am4 0 :ssg4 0))
(def mod (voice :alg 4 :fb 0
  :ar1 31 :dr1 0 :sr1 0 :rr1 6 :sl1 0 :tl1 20 :ks1 0 :ml1 1 :dt1 0 :am1 0 :ssg1 0
  :ar2 31 :dr2 0 :sr2 0 :rr2 6 :sl2 0 :tl2 20 :ks2 0 :ml2 1 :dt2 0 :am2 0 :ssg2 0
  :ar3 31 :dr3 0 :sr3 0 :rr3 6 :sl3 0 :tl3 20 :ks3 0 :ml3 1 :dt3 0 :am3 0 :ssg3 0
  :ar4 31 :dr4 0 :sr4 0 :rr4 6 :sl4 0 :tl4 20 :ks4 0 :ml4 1 :dt4 0 :am4 0 :ssg4 0))
(def kit (voice :alg 7 :fb 0
  :ar1 31 :dr1 0 :sr1 0 :rr1 6 :sl1 0 :tl1 20 :ks1 0 :ml1 1 :dt1 0 :am1 0 :ssg1 0
  :ar2 31 :dr2 0 :sr2 0 :rr2 6 :sl2 0 :tl2 20 :ks2 0 :ml2 1 :dt2 0 :am2 0 :ssg2 0
  :ar3 31 :dr3 0 :sr3 0 :rr3 6 :sl3 0 :tl3 20 :ks3 0 :ml3 1 :dt3 0 :am3 0 :ssg3 0
  :ar4 31 :dr4 0 :sr4 0 :rr4 6 :sl4 0 :tl4 20 :ks4 0 :ml4 1 :dt4 0 :am4 0 :ssg4 0))
(def kit2 (voice :alg 7 :fb 0
  :ar1 31 :dr1 0 :sr1 0 :rr1 6 :sl1 0 :tl1 40 :ks1 0 :ml1 1 :dt1 0 :am1 0 :ssg1 0
  :ar2 31 :dr2 0 :sr2 0 :rr2 6 :sl2 0 :tl2 12 :ks2 0 :ml2 1 :dt2 0 :am2 0 :ssg2 0
  :ar3 31 :dr3 0 :sr3 0 :rr3 6 :sl3 0 :tl3 20 :ks3 0 :ml3 1 :dt3 0 :am3 0 :ssg3 0
  :ar4 31 :dr4 0 :sr4 0 :rr4 6 :sl4 0 :tl4 20 :ks4 0 :ml4 1 :dt4 0 :am4 0 :ssg4 0))
(fm1 :tempo 120 lead :oct 4 :vol 24 :len 1 c :tl1 40)
(fm2 mod :oct 4 :vol 24 :len 1 c :tl1 40 :tl2 40)
(fm3 kit :len 4 _ _ kit2 _ _)
(fm3-1 :oct 5 :len 1 :vol 24 c)
(fm3-2 :oct 4 :len 4 c e :vol 20 g c)
