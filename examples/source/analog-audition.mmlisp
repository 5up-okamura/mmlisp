(import "../../presets/waveforms/waveforms.mmlisp")
(def title "Analog basic waveform audition")
(fm1 :tempo 120 :vel 15 :vol 31 :len 4
  ; sine: C3, C4, C5, then a short phrase.
  wave-sine :oct 3 c _ :oct 4 c _ :oct 5 c _
  :oct 4 :len 8 c e g > c < g e c _ :len 4
  ; triangle: C3, C4, C5, then a short phrase.
  wave-triangle :oct 3 c _ :oct 4 c _ :oct 5 c _
  :oct 4 :len 8 c e g > c < g e c _ :len 4
  ; saw: C3, C4, C5, then a short phrase.
  wave-saw :oct 3 c _ :oct 4 c _ :oct 5 c _
  :oct 4 :len 8 c e g > c < g e c _ :len 4
  ; square: C3, C4, C5, then a short phrase.
  wave-square :oct 3 c _ :oct 4 c _ :oct 5 c _
  :oct 4 :len 8 c e g > c < g e c _ :len 4
  ; pulse-25: C3, C4, C5, then a short phrase.
  wave-pulse-25 :oct 3 c _ :oct 4 c _ :oct 5 c _
  :oct 4 :len 8 c e g > c < g e c _ :len 4
)
