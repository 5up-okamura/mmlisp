; delay: sticky track state. Every note that follows leaves repeats in the
; gaps after it; the phrase keeps its length. A written note always wins: a
; tap landing while one sounds is dropped, and one in a gap is cut short at
; the next. :gate sets where the dry note lets the taps in. (delay none) turns
; it off.
(import "presets/gm/set.mmlisp")

(fm1 :tempo 110 :oct 5 gm-marimba
  ; dotted-eighth delay, each tap 4 velocity steps quieter: two land in the
  ; rest, the third on the next note — and the written note wins
  (delay 3 :vel+ -4 :time 8.)
  :len 4 :gate 8. c _ g _ e _ d _

  ; a list gives each tap its own ratio
  (delay :vel* [0.7 0.45 0.25] :time 16)
  :len 8 :gate 16 c _ _ _ e _ _ _ g _ _ _ > c < _ _ _

  ; a curve is the envelope, its :len / :time taps (five here). Every note
  ; leaves its own, so with :time as long as the phrase the whole phrase
  ; repeats, fading to vel 0 — which FM still sounds
  (delay :vel* (linear 0.9..0 :len 1) :time 8.)
  :len 16 c g > c
  (delay none))
