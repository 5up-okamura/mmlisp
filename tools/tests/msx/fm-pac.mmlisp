; msx: the FM-PAC's YM2413 — ROM voices by name, a user voice that extends
; one, the two-operator words inline and as macros, :sus, vel and vol on the
; channel volume, a vibrato and a glide, and fm7-fm9 beside the PSG.
(def-score :target msx :title "msx fm-pac")
(def-fm reed clarinet :ws1 1 :ar2 11 :rr2 6)
(fm1 :tempo 120 piano :len 8 (macro :vel (linear 15..7 :len 2)) c e g > c < g e c e |)
(fm2 synth-bass :oct 2 :len 4 c c g g |)
(fm3 reed :len 4 :vol 26 e (macro :pitch (sin -25..25 :len 8f)) g ~ g a |)
(fm4 violin :sus 1 :len 2 :gate 1/2 c (glide 8) e |)
(fm5 organ :len 8 c _ (macro :tl1 (linear 30..0 :len 4)) c _ :ksl1 3 :vib2 1 c _ c _ |)
(fm7 flute :oct 5 :vol 24 :len 4 g e c e |)
(fm8 harpsichord :oct 5 :vol 24 :len 8 c c e e guitar g g reed e e |)
(fm9 vibraphone :oct 5 :len 2 c g |)
(sqr1 :len 8 :vol 20 c _ c _ c _ c _ |)
