; fm6 and the PCM in turn (language.md §16): a PCM note takes fm6 as the DAC
; ($2B on), an fm6 note takes it back ($2B off, sent ahead of the frame's FM
; through the PCM lane), and the next PCM note turns it on again. pcm2's
; held loop plays on under the fm6 notes, unheard, and is heard again when
; pcm1's next note takes the DAC.
(def-pcm blip :file "blip.wav")
(def-pcm pad :file "pad.wav" :loop-start 9ms :loop-end 36ms)
(def-score :pcm-voices 2)
(def-fm bell :alg 4 :fb 3
  :ar1 31 :dr1 6 :sr1 1 :rr1 6 :sl1 2 :tl1 24 :ks1 0 :ml1 2 :dt1 0
  :ar2 31 :dr2 8 :sr2 2 :rr2 8 :sl2 2 :tl2 8 :ks2 0 :ml2 1 :dt2 0
  :ar3 31 :dr3 6 :sr3 1 :rr3 6 :sl3 2 :tl3 28 :ks3 0 :ml3 4 :dt3 0
  :ar4 31 :dr4 9 :sr4 2 :rr4 9 :sl4 3 :tl4 4 :ks4 0 :ml4 1 :dt4 0)
(pcm1 :tempo 120 :oct 4 :len 4 blip c c _ _ c c _ _)
(pcm2 :oct 4 :len 1 :mode loop pad c)
(fm6 bell :oct 5 :len 4 _ _ c e _ _ g c)
(fm1 bell :oct 4 :len 2 c e g c)
