; Wavetable steps for the machines with wave channels (msx's SCC, pce, fc's
; FDS and N163): 32 steps of -128..127, the form every one of them takes. See
; README.md.

; A sine.
(def-wave wt-sine
  :wave [
    0 25 49 71 90 106 117 125 127 125 117 106 90 71 49 25
    0 -25 -49 -71 -90 -106 -117 -125 -127 -125 -117 -106 -90 -71 -49 -25
  ]
)

; A triangle.
(def-wave wt-triangle
  :wave [
    0 16 32 48 64 79 95 111 127 111 95 79 64 48 32 16
    0 -16 -32 -48 -64 -79 -95 -111 -127 -111 -95 -79 -64 -48 -32 -16
  ]
)

; A saw, up to a drop.
(def-wave wt-saw
  :wave [
    -128 -120 -112 -103 -95 -87 -79 -70 -62 -54 -46 -38 -29 -21 -13 -5
    4 12 20 28 37 45 53 61 69 78 86 94 102 111 119 127
  ]
)

; A square: 1:1.
(def-wave wt-square
  :wave [
    127 127 127 127 127 127 127 127 127 127 127 127 127 127 127 127
    -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128
  ]
)

; A pulse: 1:3.
(def-wave wt-pulse25
  :wave [
    127 127 127 127 127 127 127 127 -128 -128 -128 -128 -128 -128 -128 -128
    -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128
  ]
)

; A pulse: 1:7.
(def-wave wt-pulse12
  :wave [
    127 127 127 127 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128
    -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128 -128
  ]
)

; Harmonics 1, 2, 3 and 4 in falling levels.
(def-wave wt-organ
  :wave [
    0 62 108 127 120 97 71 53 45 45 45 40 29 16 6 1
    0 -1 -6 -16 -29 -40 -45 -45 -45 -53 -71 -97 -120 -127 -108 -62
  ]
)

; Harmonics 1, 3, 5 and 8: hollow and bright.
(def-wave wt-bell
  :wave [
    0 93 113 88 79 76 58 54 82 93 58 37 79 127 113 54
    0 -54 -113 -127 -79 -37 -58 -93 -82 -54 -58 -76 -79 -88 -113 -93
  ]
)
