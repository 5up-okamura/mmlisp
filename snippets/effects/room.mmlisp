; A room without a reverb unit: the dry part on one channel, and "wet" copies
; of it on others, later, quieter, darker and with longer tails, the way
; reflections come back from walls. Each wet voice is the dry one with its
; modulators turned down and its release slowed (def-fm variants).
(def-fm dry init-fm :alg 4 :fb 4
  :ar1 31 :dr1 6 :sl1 4 :tl1 26 :ml1 2
  :ar2 31 :dr2 4 :sl2 6 :tl2 4  :rr2 6
  :ar3 31 :dr3 6 :sl3 4 :tl3 30 :ml3 1
  :ar4 31 :dr4 4 :sl4 6 :tl4 6  :rr4 6)
(def-fm wet1 dry :tl1 40 :tl3 44 :rr2 3 :rr4 3)
(def-fm wet2 dry :tl1 56 :tl3 60 :rr2 2 :rr4 2)

(def phrase :len 8 e g a g  e d c _  d e g e  d c :len 4 c)

(fm1 :tempo 104 :oct 5 dry :pan center
  phrase)
(fm2 :oct 5 wet1 :vel 10 :pan left
  :len 16 _ phrase)
(fm3 :oct 5 wet2 :vel 8 :pan right
  :len 8. _ phrase)
