; Daisy Bell, after the 1961 IBM 7094 performance (voice by Kelly and
; Lochbaum, accompaniment by Max Mathews), the first computer to sing. The
; voice is CSM as in csm-voice: the vowel is four formant MLs over a base,
; the melody is the Timer A rate, and the noise channel adds consonants. The
; three squares play the waltz accompaniment.

(def-fm vox init-fm :alg 7 :fb 0
  :ar1 31 :rr1 13 :tl1 4
  :ar2 31 :rr2 14 :tl2 10
  :ar3 31 :rr3 15 :tl3 18
  :ar4 31 :rr4 15 :tl4 26)

; vowel = base note x ML per operator (formants F1-F4)
(def ah :oct 4 :ml1 2 :ml2 3 :ml3 7  :ml4 9  f+)
(def ee :oct 4 :ml1 1 :ml2 8 :ml3 11 :ml4 13 c+)
(def oo :oct 4 :ml1 1 :ml2 3 :ml3 8  :ml4 11 d)
(def eh :oct 4 :ml1 2 :ml2 7 :ml3 9  :ml4 12 c)
(def oh :oct 4 :ml1 2 :ml2 3 :ml3 9  :ml4 12 c+)

; each syllable swells in from a lower fader
(def (sy v) :vol (linear 14..31 :len 16) v)

(fm3-csm vox :tempo 150
  ; Dai-sy, Dai-sy, give me your an-swer, do
  :len 2. (sy ah) (sy ee) (sy ah) (sy ee)
  :len 4 (sy ee) (sy ee) (sy oh) :len 2 (sy ah) :len 4 (sy eh) :len 1. (sy oo)
  ; I'm half cra-zy, all for the love of you
  :len 2. (sy ah) (sy ah) (sy eh) (sy ee)
  :len 4 (sy oh) (sy oh) (sy eh) :len 2 (sy ah) :len 4 (sy oh) :len 1 (sy oo) :len 4 _
  ; It won't be a sty-lish mar-riage
  (sy ee) (sy oh) (sy ee) (sy ah) :len 2 (sy ah) :len 4 (sy ee) (sy ah) :len 1 (sy ee)
  ; I can't af-ford a car-riage
  :len 4 (sy ah) :len 2 (sy ah) :len 4 (sy ah) :len 2 (sy oh) :len 4 (sy ah) (sy ah) :len 1 (sy ee)
  ; But you'll look sweet u-pon the seat of a bi-cy-cle built for two
  :len 4 (sy ah) :len 2 (sy oo) :len 4 (sy oo) :len 2 (sy ee) :len 4 (sy oo)
  :len 2 (sy oh) :len 4 (sy eh) (sy ee) (sy oh) (sy ah) (sy ah) (sy ee) (sy oh)
  :len 2 (sy ee) :len 4 (sy oh) :len 1. (sy oo))

; the melody: notes here are Timer A rates
(fm3-csm-rate :oct 4 (glide 16)
  :len 2. g e c < g
  :len 4 a b > c :len 2 < a :len 4 > c :len 1. < g
  :len 2. > d g e c
  :len 4 < a b > c :len 2 d :len 4 e d1 ~ d4
  :len 4 e f e d :len 2 g :len 4 e d c1
  :len 4 d :len 2 e :len 4 c :len 2 < a :len 4 > c < a g1
  :len 4 g :len 2 > c :len 4 e :len 2 d :len 4 < g
  :len 2 > c :len 4 e d e f g e c :len 2 d :len 4 < g :len 1. > c)

; consonants: a hiss for s, a breath for h and f, clicks for k/t and d/b/g
(def sh :mode white0 (macro :vel [7 9 9 9 8 7 5 3 1 0]))
(def hh :mode white0 (macro :vel [6 5 4 2 0]))
(def kh :mode white1 (macro :vel [13 8 3 0]))
(def gh :mode white1 (macro :vel [8 4 0]))

(noise
  :len 2. gh c sh c gh c sh c
  :len 4 gh c _ _ :len 2 _ :len 4 sh c :len 1. gh c
  :len 2. _ hh c kh c sh c
  :len 4 _ hh c _ :len 2 _ :len 4 _ :len 1 _ :len 4 _
  :len 4 _ _ gh c _ :len 2 sh c :len 4 _ _ :len 1 _
  :len 4 _ :len 2 kh c :len 4 _ :len 2 hh c :len 4 _ kh c :len 1 _
  :len 4 gh c :len 2 _ :len 4 _ :len 2 sh c :len 4 _
  :len 2 gh c :len 4 _ sh c _ _ gh c sh c kh c :len 2 gh c :len 4 hh c :len 1. kh c)

; waltz accompaniment: bass on the downbeat, the chord on two and three
(def bC :oct 3 :len 4 c _ _)  (def mC :oct 4 :len 4 _ e e)  (def hC :oct 4 :len 4 _ g g)
(def bF :oct 3 :len 4 f _ _)  (def mF :oct 4 :len 4 _ f f)  (def hF :oct 4 :len 4 _ a a)
(def bG :oct 3 :len 4 g _ _)  (def mG :oct 4 :len 4 _ d d)  (def hG :oct 4 :len 4 _ f f)
(def bD :oct 3 :len 4 d _ _)  (def mD :oct 4 :len 4 _ c c)  (def hD :oct 4 :len 4 _ f+ f+)

(sqr3 :vel 10
  bC bC bF bC bF bF bC bG  bG bG bC bC bD bG bG bG
  bG bC bC bC bC bF bC bG  bC bG bC bG bC bG bC bC)
(sqr2 :vel 8
  mC mC mF mC mF mF mC mG  mG mG mC mC mD mG mG mG
  mG mC mC mC mC mF mC mG  mC mG mC mG mC mG mC mC)
(sqr1 :vel 8
  hC hC hF hC hF hF hC hG  hG hG hC hC hD hG hG hG
  hG hC hC hC hC hF hC hG  hC hG hC hG hC hG hC hC)
