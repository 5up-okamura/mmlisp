+// ── MMLispDRV: the watched globals ────────────────────────────────────────
+// Plain RAM with a log on the write side. It adds no emulated cycles — the
+// chunk declares no read_cycles or write_cycles — so a build measured with the
+// watch on is the same build, running the same schedule, as one measured
+// without it. That is the point: the record being compared comes from the image
+// under test rather than from a heavier twin that publishes it over the bus.
+static uint8_t z80_read_watched(uint32_t location, void *vcontext)
+{
+	z80_context *context = vcontext;
+	genesis_context *gen = context->system;
+	return gen->zram[location & 0x1FFF];
+}
+
+static void *z80_write_watched(uint32_t location, void *vcontext, uint8_t value)
+{
+	z80_context *context = vcontext;
+	genesis_context *gen = context->system;
+	gen->zram[location & 0x1FFF] = value;
+	// TWO watched ranges, one event kind. The globals page is reported as its
+	// own 0..7F offset; the 32-byte publication region is reported with bit 7
+	// set, so a reader can tell "the engine's state changed" from "the engine
+	// published a snapshot" without a second event kind and without the two
+	// offset spaces colliding.
+	// `location` arrives with high bits set — the original code only ever
+	// masked it to seven, which is why it worked and why a second range that
+	// tests the address needs the mask made explicit.
+	uint16_t z80addr = location & 0x1FFF;
+	uint8_t off = (z80addr >= 0x1F00) ? (z80addr & 0x7F) : (0x80 | (z80addr & 0x1F));
+	mml_probe_log(MML_PROBE_Z80RAM, (off << 8) | value, context->Z80_CYCLE);
+	return context;
+}
