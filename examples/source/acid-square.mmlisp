(import "../../presets/acid/tb303.mmlisp")
(def title "303-inspired FM — square")
; One slider: right = brighter (smaller modulator attenuation).
(def-val color 8 16..0 :step 1)

; Read color at each new attack; keep slide destinations legato.
; Performance fragments: velocity + brightness + envelope decay.
; Smaller modulator TL means stronger modulation (brighter), not a real cutoff.
(def acid-normal :vel 12
  :tl1       (+ 22 $color)
  :tl2       (+ 26 $color)
  :tl3 (+ 24 (* $color 2))
  :dr3 (+ 6 $color)
  :sl3 5
)
(def acid-accent :vel 15
  :tl1       (+ 18 $color)
  :tl2       (+ 22 $color)
  :tl3 (+ 18 (* $color 2))
  :dr3 (+ 10 $color)
  :sl3 5
)

; 16 sixteenth-note steps. Set octave and default length before use.
; Slides: steps 4->5, 9->10 and 14->15; only the destination enables glide.
(def acid-pattern-16
  acid-normal e acid-normal e _
  acid-accent e ~ (glide 32) g
  (glide none) acid-normal b _ acid-normal d
  acid-accent > e ~ (glide 32) d <
  (glide none) acid-normal b _ acid-normal g
  acid-normal e ~ (glide 32) b
  (glide none) acid-normal e
)

; One-channel acid bass. Four repetitions of the same 16-step pattern.
(fm1 :tempo 130 :oct 2 :len 16 :vol 31
  acid-square
  acid-pattern-16
  acid-pattern-16
  acid-pattern-16
  acid-pattern-16
)
