 // PCM_SAMPLES_PER_FRAME of them — the same arithmetic frame-budget's SAMPLE_CY
@@ -1767,6 +1769,21 @@ PCM_TA_LO   equ 0`}
 ; PCM track a frame early. Anything else is an offset between the PCM and the
 ; FM that nothing takes back out (live/src/mmb.js, PCM_RING_TARGET).
 PCM_RING_TARGET equ ${PCM_RING_TARGET}
+
+; TICKS THE MIXER DOES IN ONE GO before it looks at the ring again (§5.1.3).
+; The frame's chunk is worked off in blocks by the idle loop, so this is the
+; grain of the ring's fill: its trough is one block deep, and one block of
+; per-pass setup (ms_bind, latch_bank, plan_next, ms_pload — about 500 cycles a
+; voice) is what a block costs over doing the frame in one piece. A quarter of a
+; frame is the balance: four blocks a frame is ~1,500 extra cycles, 2.5% of a
+; vblank, against a trough that was a whole frame deep.
+PCM_MIX_BLOCK equ ${MIX_BLOCK_N}
+
+; …and the LOW-WATER MARK it waits for. The idle loop mixes a block only once
+; the DAC has taken one, so the fill oscillates in a band one block wide just
+; under the target instead of sawtoothing a whole frame. Production then tracks
+; consumption by construction, which is the thing the lead's margin was buying.
+PCM_MIX_GO  equ ${Math.max(1, PCM_RING_TARGET - MIX_BLOCK_N)}
 `;
 }
 
