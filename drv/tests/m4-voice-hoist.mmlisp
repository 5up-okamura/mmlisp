; Voice changes move into the silence before their note (live/src/voice-hoist.js).
; One case a channel: after a rest; after a note that ran into the next (cut
; about 40 ms short); after a :gate- note (its own silence); after a tie chain;
; after a loop that ends in a rest (the rest is peeled out of the final pass);
; and a voice change inside a slur, which stays where it was written.

(def-fm lead :alg 4 :fb 3
  :ar1 28 :dr1 6 :sr1 1 :rr1 6 :sl1 2 :tl1 30 :ks1 1 :ml1 2 :dt1 2
  :ar2 31 :dr2 9 :sr2 2 :rr2 8 :sl2 2 :tl2 6 :ks2 0 :ml2 1 :dt2 0
  :ar3 26 :dr3 5 :sr3 1 :rr3 6 :sl3 1 :tl3 34 :ks3 1 :ml3 4 :dt3 -2
  :ar4 31 :dr4 10 :sr4 2 :rr4 9 :sl4 3 :tl4 4 :ks4 0 :ml4 1 :dt4 0)

(def-fm stab :alg 7 :fb 2
  :ar1 31 :dr1 5 :sr1 0 :rr1 7 :sl1 1 :tl1 20 :ks1 0 :ml1 1 :dt1 1
  :ar2 31 :dr2 6 :sr2 1 :rr2 7 :sl2 2 :tl2 12 :ks2 0 :ml2 3 :dt2 0
  :ar3 31 :dr3 5 :sr3 0 :rr3 7 :sl3 1 :tl3 20 :ks3 0 :ml3 1 :dt3 2
  :ar4 31 :dr4 6 :sr4 1 :rr4 7 :sl4 2 :tl4 4 :ks4 0 :ml4 5 :dt4 0)

(fm1 :tempo 150 :oct 4 :len 4 :vel 12 lead c _ stab :vel 10 e _ lead g)
(fm2 :oct 3 :len 4 :vel 12 lead c stab e lead g c)
(fm3 :oct 4 :len 4 :vel 11 :gate- 10t lead e stab g lead > c)
(fm4 :oct 3 :len 4 :vel 12 lead c ~ c ~ c stab e lead g)
(fm5 :oct 4 :len 8 :vel 11 lead (x 3 c _) stab :pan -1 e4 lead :pan 0 g4)
(fm6 :oct 3 :len 4 :vel 12 lead c ~ stab e lead g)
