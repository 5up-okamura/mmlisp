{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.mmlisp",
  "name": "MMLisp",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#def-form" },
    { "include": "#form-head" },
    { "include": "#label-decl" },
    { "include": "#keyword" },
    { "include": "#value-slot" },
    { "include": "#rest-shorthand" },
    { "include": "#octave-shift" },
    { "include": "#slur" },
    { "include": "#volume-shift" },
    { "include": "#fraction" },
    { "include": "#number" },
    { "include": "#paren" },
    { "include": "#bracket" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.mmlisp",
      "match": ";.*$"
    },
    "string": {
      "name": "string.quoted.double.mmlisp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mmlisp",
          "match": "\\\\."
        }
      ]
    },
    "def-form": {
      "match": "(?<=\\()\\s*(def(?:-[a-z]+)?)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)",
      "captures": {
        "1": { "name": "entity.name.function.mmlisp" },
        "2": { "name": "entity.name.constant.mmlisp" }
      }
    },
    "form-head": {
      "match": "(?<=\\()\\s*([a-zA-Z][a-zA-Z0-9_-]*)",
      "captures": {
        "1": { "name": "entity.name.function.mmlisp" }
      }
    },
    "label-decl": {
      "match": "(#)([a-zA-Z][a-zA-Z0-9_-]*)",
      "captures": {
        "1": { "name": "keyword.other.control-flow.mmlisp" }
      }
    },
    "keyword": {
      "name": "constant.other.keyword.mmlisp",
      "match": ":[a-zA-Z][a-zA-Z0-9_+-]*"
    },
    "value-slot": {
      "name": "variable.other.slot.mmlisp",
      "match": "\\$[a-zA-Z][a-zA-Z0-9_-]*"
    },
    "rest-shorthand": {
      "name": "constant.language.mmlisp",
      "match": "(?<=\\s)_(?=[\\s)])"
    },
    "octave-shift": {
      "name": "constant.language.mmlisp",
      "match": "(?<=[\\s(])[><](?=[\\s)])"
    },
    "slur": {
      "name": "constant.language.mmlisp",
      "match": "(?<=[\\s(])~(?=[\\s)])"
    },
    "volume-shift": {
      "name": "constant.language.mmlisp",
      "match": "(?<=[\\s(])v[+-]\\d*(?=[\\s)])"
    },
    "fraction": {
      "name": "constant.numeric.fraction.mmlisp",
      "match": "\\d+/\\d+"
    },
    "number": {
      "name": "constant.numeric.mmlisp",
      "match": "(?<=[\\s(\\[])[+-]?\\d+(?:\\.\\d+)?(?:\\.\\.[+-]?\\d+(?:\\.\\d+)?)?(?:ms|s|f|t)?(?=[\\s)\\]])"
    },
    "paren": {
      "name": "punctuation.section.parens.mmlisp",
      "match": "[()]"
    },
    "bracket": {
      "name": "punctuation.section.brackets.mmlisp",
      "match": "[\\[\\]]"
    }
  }
}
