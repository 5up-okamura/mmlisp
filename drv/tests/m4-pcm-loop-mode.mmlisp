; M4 gate: WHICH range a note plays (pcm-loop-gate.mjs checks each START).
;   1  a shot on a def with a range plays that range once — the note's
;      :mode decides whether it repeats
;   2  a shot on a def with no range plays the whole sample
;   3  a loop note on a def with no range loops the whole sample
;   4  range points written on the track BEFORE the note are the note's
;   5  …and stay for the next note, as does :mode loop (track parameters
;      are sticky)
;   6  :pcm-end pins the end; the start written earlier still holds
;   7  :mode shot, written, plays the track's range once
(def pcm-voices 1)
(def-pcm pad :file "pad.wav" :pcm-start 16ms :pcm-end 45ms)
(def-pcm voice :file "pcmbank.wav")
(pcm1 pad :tempo 120 :oct 4 :len 4 :vel 15
  c
  voice c
  :mode loop c
  :pcm-start 100ms :pcm-len 16 c
  c
  :pcm-end 300ms c
  pad :mode shot c)
