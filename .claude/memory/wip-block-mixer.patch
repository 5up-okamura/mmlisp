 //
 // So the threshold sits between 672 and 538 — 600, which is the only number
 // here that was chosen rather than measured.
+export const MIX_BLOCKS = Number(process.env.MIX_BLOCKS ?? 4);
+const MIX_BLOCK_N = Math.max(8, Math.ceil(PCM_RING_TARGET / MIX_BLOCKS));
 export const ASK_DENSE_CY = 600;
