; The melodic roles as FM voices, for the machines with 4-op FM: with this set
; imported, `piano` is a voice of its own and not the OPLL's read as 4-op. A
; machine with the OPLL has its ROM's. Written by tools/scripts/gen-fm-roles.mjs,
; from presets/gm; choose another voice there. See README.md.

; gm-piano
(def-fm piano :alg 2 :fb 0 :ams 0 :fms 0
  :ar1 26 :dr1  7 :sr1  4 :rr1 1 :sl1  7 :tl1 39 :ks1 1 :ml1 1 :dt1  0 :ssg1 0 :am1 0
  :ar2 31 :dr2 23 :sr2 15 :rr2 1 :sl2  9 :tl2  4 :ks2 3 :ml2 2 :dt2 -3 :ssg2 0 :am2 0
  :ar3 24 :dr3  9 :sr3  9 :rr3 7 :sl3  6 :tl3 36 :ks3 1 :ml3 4 :dt3 -2 :ssg3 0 :am3 0
  :ar4 27 :dr4  4 :sr4  4 :rr4 6 :sl4 10 :tl4  2 :ks4 2 :ml4 1 :dt4  3 :ssg4 0 :am4 0
)

