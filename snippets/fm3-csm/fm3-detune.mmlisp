; FM3 as a thick pad on one channel: every operator gets its own pitch. Two
; carriers play the root a few cents apart, one plays the fifth and glides,
; and a shared vibrato (:pitch+) moves each operator around its own offset.
(def pad4 (voice init-fm :alg 7 :fb 0
  :ar1 14 :ar2 14 :ar3 12 :ar4 10
  :tl1 12 :tl2 12 :tl3 16 :tl4 14
  :rr1 5 :rr2 5 :rr3 5 :rr4 5))

(def drift (macro :pitch+ (sin -8..8 :len 2 :wait 8)))

(fm3 pad4)
(fm3-1 :tempo 84 :oct 4 :len 1 :pitch -9 drift  c a- f g)
(fm3-2 :oct 4 :len 1 :pitch 9 drift            c a- f g)
(fm3-3 :oct 4 :len 1 (glide 4)                 g e- c d)
(fm3-4 :oct 3 :len 1 :pitch 4                  c a- f g)
