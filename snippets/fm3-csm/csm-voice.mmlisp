; CSM: Timer A re-keys FM3 at an audio rate. The rate of that buzz is the
; pitch you hear; the fm3-csm notes set where the operators ring, which is
; heard as a formant, a vowel-like colour. fm3-csm-rate plays the melody as
; notes (converted to Hz); fm3-csm moves the formant.
(def-voice vox init-fm :alg 7 :fb 0
  :ar1 31 :dr1 10 :sr1 4 :rr1 8 :sl1 4 :tl1 20 :ml1 3
  :ar2 31 :dr2 12 :sr2 5 :rr2 9 :sl2 5 :tl2 18 :ml2 5
  :ar3 31 :dr3 10 :sr3 4 :rr3 8 :sl3 4 :tl3 22 :ml3 7
  :ar4 31 :dr4 14 :sr4 6 :rr4 10 :sl4 6 :tl4 8 :ml4 2)

; the formant: a slow walk, "a... o... e..."
(fm3-csm vox :tempo 100 :oct 3 :len 1 :vel 13
  c a- f e-)

; the melody: notes on this track are Timer A rates
(fm3-csm-rate :oct 3 :len 4
  c e- g e- f a- > c < a- g f e- d c1)
