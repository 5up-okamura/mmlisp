; pc88: the ROM rhythm (rhythm1-rhythm3, the built-in kit roles) and the ADPCM-B
; (pcm1 — no sample here: its bake is not built, so it has none to play).
(def-score :target pc88 :title "pc88 rhythm")
(rhythm1 :tempo 132 :len 4 kick c c c c |)
(rhythm2 :len 8 hat c c c c c c c c |)
(rhythm3 :len 2 _ snare c :pan right |)
(rhythm3 :len 4 _ _ _ rim :vel 10 c |)
; one track's :prio layers are one line: a rim that starts under a tom is dropped
(rhythm4 :prio 1 :len 4 tom4 c _ c _ |)
(rhythm4 :prio 2 :len 8 rim c c c c c c c c |)
