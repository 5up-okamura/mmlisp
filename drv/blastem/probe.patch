diff --git a/util.c b/util.c
index 2cba3fa..9afdf26 100644
--- a/util.c
+++ b/util.c
@@ -1109,3 +1109,25 @@ FILE* fopen_wrapper(const char *path, const char *mode)
 
 #endif //defined(__ANDROID__) && !defined(IS_LIB)
 
+// ── MMLispDRV probe (see util.h) ───────────────────────────────────────────
+// Eight bytes a record, little-endian, so that a run of a few minutes is a few
+// megabytes and the reader is four lines of JavaScript. Buffered by stdio and
+// flushed at exit; a run that crashes loses at most a buffer, and a run that
+// crashes has already told you what you needed.
+static FILE *mml_probe_file;
+static int   mml_probe_tried;
+
+void mml_probe_log(uint8_t kind, uint16_t value, uint32_t cycle)
+{
+	if (!mml_probe_tried) {
+		mml_probe_tried = 1;
+		const char *path = getenv("MMLISP_PROBE_LOG");
+		if (path && *path) mml_probe_file = fopen(path, "wb");
+	}
+	if (!mml_probe_file) return;
+	uint8_t rec[8] = {
+		kind, 0, value & 0xFF, value >> 8,
+		cycle & 0xFF, cycle >> 8, cycle >> 16, cycle >> 24
+	};
+	fwrite(rec, 1, sizeof(rec), mml_probe_file);
+}
diff --git a/util.h b/util.h
index 8b7d75d..fbfd6a3 100644
--- a/util.h
+++ b/util.h
@@ -2,6 +2,7 @@
 #define UTIL_H_
 
 #include <stdio.h>
+#include <stdint.h>
 #include <time.h>
 #include <wchar.h>
 #include <stdarg.h>
@@ -112,4 +113,21 @@ char *fgets_timeout(char *dst, size_t size, FILE *f, uint64_t timeout_usec, void
 FILE* fopen_wrapper(const char *path, const char *mode);
 #endif
 
+// ── MMLispDRV probe ────────────────────────────────────────────────────────
+// A timestamped log of the few events the MMLisp driver's DAC work turns on:
+// every $2A write, every Z80 bus grab, and the instant of each Z80 vblank. All
+// cycles are MASTER clocks (53,693,175 Hz NTSC), which is what every subsystem
+// in this emulator counts in.
+//
+// Off unless MMLISP_PROBE_LOG names a file, and it writes nothing at all in
+// that case — the emulated machine's timing must not depend on whether it is
+// being watched.
+#define MML_PROBE_DAC     1   /* value = the byte written to $2A            */
+#define MML_PROBE_GRAB    2   /* the 68000 asserted BUSREQ                  */
+#define MML_PROBE_RELEASE 3   /* ...and released it                         */
+#define MML_PROBE_VINT    4   /* the instant the Z80's /INT is due          */
+#define MML_PROBE_DACEN   5   /* value = the byte written to $2B            */
+#define MML_PROBE_DACPC   6   /* value = the Z80 PC that wrote $2A          */
+void mml_probe_log(uint8_t kind, uint16_t value, uint32_t cycle);
+
 #endif //UTIL_H_
