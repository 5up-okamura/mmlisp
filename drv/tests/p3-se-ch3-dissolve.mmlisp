; P3 gate: a song START_TRACK on CH3 while a CSM effect holds it dissolves the
; hold (driver.md §2.5), and CSM goes with the effect: the song's mode and
; Timer A come back, the rate sweep stops, and the song's fm3 is not keyed by
; Timer A. (p3-se-ch3-dissolve.cmds.json: buzz at 30, fm3 restarted at 40.)
(def-fm pad :alg 4 :fb 2
  :ar1 20 :dr1 4 :sr1 1 :rr1 6 :sl1 2 :tl1 28 :ml1 1 :ks1 0 :dt1 0
  :ar2 22 :dr2 5 :sr2 1 :rr2 6 :sl2 2 :tl2 10 :ml2 1 :ks2 0 :dt2 0
  :ar3 20 :dr3 4 :sr3 1 :rr3 6 :sl3 2 :tl3 30 :ml3 2 :ks3 0 :dt3 0
  :ar4 22 :dr4 5 :sr4 1 :rr4 6 :sl4 2 :tl4 8 :ml4 1 :ks4 0 :dt4 0)
(def-fm buzz :alg 7 :fb 0
  :ar1 31 :dr1 10 :sr1 4 :rr1 8 :sl1 4 :tl1 20 :ml1 3 :ks1 0 :dt1 0
  :ar2 31 :dr2 12 :sr2 5 :rr2 9 :sl2 5 :tl2 18 :ml2 5 :ks2 0 :dt2 0
  :ar3 31 :dr3 10 :sr3 4 :rr3 8 :sl3 4 :tl3 22 :ml3 7 :ks3 0 :dt3 0
  :ar4 31 :dr4 14 :sr4 6 :rr4 10 :sl4 6 :tl4 8 :ml4 2 :ks4 0 :dt4 0)

(fm3 :tempo 120 pad :oct 3 :len 4 :vel 13  e g b e g b e g)   ; track 0 — CH3, normal mode

(def-se buzz :prio 5
  (fm3-csm buzz :oct 3 :len 2 :vel 13 :csm-rate 440  c :csm-rate (linear 440..880 :len 2) c))
