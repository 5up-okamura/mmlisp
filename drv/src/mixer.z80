        inc  de                ; baked at this note: one sample per tick
        ld   a,(de)             ; sample
        add  a,(hl)
        jp   pe,ov126
dn127:
        ld   (hl),a
        inc  l
        inc  de                ; baked at this note: one sample per tick
        dec  b
        jp   nz,mix_addnr_s0_lp
        ret
ov124:
        jp   m,ov124_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn125
ov124_hi:
        ld   a,$7f
        jp   dn125
ov126:
        jp   m,ov126_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn127
ov126_hi:
        ld   a,$7f
        jp   dn127
mix_addnr_s1:
mix_addnr_s1_lp:
        ex   af,af'            ; A' is the gate phase (1..GROUP); see gatePrologue
        dec  a
        jr   nz,ep130          ; PATCHED: ep130 at unity, ea130 under a shift
        call gate_wait         ; hold for Timer B; returns A = PCM_GROUP
ea130:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ms130:
        jr   ex130             ; master chain, slot 0 — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        jr   ex130               ; …and into the tail the plain copy shares
ep130:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ex130:
        xor  $80               ; the ring is signed, the DAC is not
        ld   (YM_DATA0),a      ; $2A, fed blind
        inc  iy                ; wraps at a SEGMENT boundary, never here
        ld   a,3                ; pace: hold the tick to the sample period
pd131:
        dec  a
        jr   nz,pd131
        ld   a,(de)             ; sample
        sra  a
        add  a,(hl)
        jp   pe,ov132
dn133:
        ld   (hl),a
        inc  l
        inc  de                ; baked at this note: one sample per tick
        ld   a,(de)             ; sample
        sra  a
        add  a,(hl)
        jp   pe,ov134
dn135:
        ld   (hl),a
        inc  l
        inc  de                ; baked at this note: one sample per tick
        dec  b
        jp   nz,mix_addnr_s1_lp
        ret
ov132:
        jp   m,ov132_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn133
ov132_hi:
        ld   a,$7f
        jp   dn133
ov134:
        jp   m,ov134_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn135
ov134_hi:
        ld   a,$7f
        jp   dn135
mix_addnr_s2:
mix_addnr_s2_lp:
        ex   af,af'            ; A' is the gate phase (1..GROUP); see gatePrologue
        dec  a
        jr   nz,ep138          ; PATCHED: ep138 at unity, ea138 under a shift
        call gate_wait         ; hold for Timer B; returns A = PCM_GROUP
ea138:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ms138:
        jr   ex138             ; master chain, slot 0 — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        jr   ex138               ; …and into the tail the plain copy shares
ep138:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ex138:
        xor  $80               ; the ring is signed, the DAC is not
        ld   (YM_DATA0),a      ; $2A, fed blind
        inc  iy                ; wraps at a SEGMENT boundary, never here
        ld   a,2                ; pace: hold the tick to the sample period
pd139:
        dec  a
        jr   nz,pd139
        ld   a,(de)             ; sample
        sra  a
        sra  a
        add  a,(hl)
        jp   pe,ov140
dn141:
        ld   (hl),a
        inc  l
        inc  de                ; baked at this note: one sample per tick
        ld   a,(de)             ; sample
        sra  a
        sra  a
        add  a,(hl)
        jp   pe,ov142
dn143:
        ld   (hl),a
        inc  l
        inc  de                ; baked at this note: one sample per tick
        dec  b
        jp   nz,mix_addnr_s2_lp
        ret
ov140:
        jp   m,ov140_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn141
ov140_hi:
        ld   a,$7f
        jp   dn141
ov142:
        jp   m,ov142_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn143
ov142_hi:
        ld   a,$7f
        jp   dn143
mix_addnr_s3:
mix_addnr_s3_lp:
        ex   af,af'            ; A' is the gate phase (1..GROUP); see gatePrologue
        dec  a
        jr   nz,ep146          ; PATCHED: ep146 at unity, ea146 under a shift
        call gate_wait         ; hold for Timer B; returns A = PCM_GROUP
ea146:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ms146:
        jr   ex146             ; master chain, slot 0 — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        jr   ex146               ; …and into the tail the plain copy shares
ep146:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ex146:
        xor  $80               ; the ring is signed, the DAC is not
        ld   (YM_DATA0),a      ; $2A, fed blind
        inc  iy                ; wraps at a SEGMENT boundary, never here
        ld   a,1                ; pace: hold the tick to the sample period
pd147:
        dec  a
        jr   nz,pd147
        ld   a,(de)             ; sample
        sra  a
        sra  a
        sra  a
        add  a,(hl)
        jp   pe,ov148
dn149:
        ld   (hl),a
        inc  l
        inc  de                ; baked at this note: one sample per tick
        ld   a,(de)             ; sample
        sra  a
        sra  a
        sra  a
        add  a,(hl)
        jp   pe,ov150
dn151:
        ld   (hl),a
        inc  l
        inc  de                ; baked at this note: one sample per tick
        dec  b
        jp   nz,mix_addnr_s3_lp
        ret
ov148:
        jp   m,ov148_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn149
ov148_hi:
        ld   a,$7f
        jp   dn149
ov150:
        jp   m,ov150_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
