; Unison chorus: two channels play the same part with the same vibrato, one
; detuned a few cents by a static :pitch. :pitch+ in a macro ADDS to the
; channel's pitch offset instead of replacing it, so one shared vibrato
; wobbles around each channel's own detune. fm1 plays the line alone, then
; fm2 joins it the second time, panned apart.
(import "presets/gm/set.mmlisp")

(def vib (macro :pitch+ (sin -10..10 :len 20f)))
(def line :len 2 c e g f  e d c1)

(fm1 :tempo 90 :oct 4 gm-synstr1 :pan left vib
  line line)
(fm2 :oct 4 gm-synstr1 :pan right :pitch 9 vib
  :len 1 _ _ _ line)
