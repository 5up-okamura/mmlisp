{
  "name": "mmlispdrv",
  "private": true,
  "type": "module",
  "description": "MMLispDRV \u2014 Mega Drive sound driver: 68k sequencer, Z80 PCM/write engine, and a first-party assemble/emulate/gate toolchain",
  "scripts": {
    "emit-bin": "node tools/emit-bin.mjs",
    "sgdk:install": "node tools/install-sgdk.mjs",
    "selftest": "node tools/selftest.mjs",
    "engine:score": "node tools/engine-score-gate.mjs",
    "engine:gate": "node tools/engine-gate.mjs",
    "engine:gate:negatives": "node tools/engine-gate.mjs --negatives",
    "sgdk:lint": "node tools/sgdk-lint.mjs",
    "pairs-gate": "node tools/pairs-gate.mjs",
    "sgdk:gate": "node tools/sgdk-gate.mjs",
    "sgdk:profile": "node tools/sgdk-profile.mjs",
    "c-gate": "node tools/c-gate.mjs --bundle sgdk/example/demo.bundle.json --frames 400",
    "verify:ab": "node tools/ab-gate.mjs",
    "glide-gate": "node tools/glide-gate.mjs",
    "pcm-ab": "node tools/pcm-ab-gate.mjs",
    "mirrors": "node tools/rate-mirrors.mjs && node tools/emit-images.mjs --check && node tools/emit-bin.mjs --check && node tools/emit-banked.mjs --check",
    "emit-images": "node tools/emit-images.mjs",
    "verify:all": "npm run mirrors && npm run selftest && npm run voice-hoist && npm run c-gate && npm run c-gate:pal && npm run claim-gate && npm run claim-gate:pal && npm run pairs-gate && npm run sgdk:lint && npm run engine:gate && npm run engine:score && npm run verify:ab && npm run glide-gate && npm run pal-gate && npm run pcm-ab && npm run pcm-loop && npm run banked:gate && npm run multibank:gate",
    "light-study": "node tools/light-study.mjs",
    "pcm-render": "node tools/pcm-render.mjs",
    "pcm-trace": "node tools/pcm-trace.mjs",
    "pcm-loop": "node tools/pcm-loop-gate.mjs",
    "pal-gate": "node tools/pal-gate.mjs",
    "c-gate:pal": "node tools/c-gate.mjs --bundle sgdk/example/demo.bundle.json --frames 400 --pal",
    "claim-gate": "node tools/claim-gate.mjs",
    "claim-gate:pal": "node tools/claim-gate.mjs --pal",
    "sgdk:gate:se": "node tools/sgdk-gate.mjs sgdk/example/demo.mmlisp --se sgdk/example/demo-se.mmlisp --seconds 6",
    "multibank:gate": "node tools/multibank-gate.mjs",
    "multibank:render": "node tools/multibank-render.mjs",
    "banked:sgdk": "node tools/banked-sgdk-gate.mjs",
    "banked:gate": "node tools/banked-export-gate.mjs",
    "voice-hoist": "node tools/voice-hoist-gate.mjs",
    "onset-timing": "node tools/onset-timing.mjs"
  }
}
