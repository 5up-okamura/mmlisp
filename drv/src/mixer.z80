        sra  a                 ; …slot — PATCHED
        jr   ex111               ; …and into the tail the plain copy shares
ep111:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ex111:
        xor  $80               ; the ring is signed, the DAC is not
        ld   (YM_DATA0),a      ; $2A, fed blind
        inc  iy                ; wraps at a SEGMENT boundary, never here
        ld   a,(de)             ; sample
        add  a,(hl)
        jp   pe,ov112
dn113:
        ld   (hl),a
        inc  l
        inc  de                ; pre-resampled: one sample per tick
        ld   a,(de)             ; sample
        add  a,(hl)
        jp   pe,ov114
dn115:
        ld   (hl),a
        inc  l
        inc  de                ; pre-resampled: one sample per tick
        dec  b
        jp   nz,mix_addnr_s0_lp
        ret
ov112:
        jp   m,ov112_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn113
ov112_hi:
        ld   a,$7f
        jp   dn113
ov114:
        jp   m,ov114_hi        ; overflow inverts the sign, so a negative
        ld   a,$80             ; result means the true value was positive
        jp   dn115
ov114_hi:
        ld   a,$7f
        jp   dn115
mix_addnr_s1:
mix_addnr_s1_lp:
        ex   af,af'            ; A' is the gate phase (1..GROUP); see gatePrologue
        dec  a
        jr   nz,ep118          ; PATCHED: ep118 at unity, ea118 under a shift
        call gate_wait         ; hold for Timer B; returns A = PCM_GROUP
ea118:
        ex   af,af'            ; …and the mixer's A and flags come back
        ld   a,(iy+0)          ; the ring: what an earlier frame finished
ms118:
        jr   ex118             ; master chain, slot 0 — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        sra  a                 ; …slot — PATCHED
        jr   ex118               ; …and into the tail the plain copy shares
ep118:
        ex   af,af'            ; …and the mixer's A and flags come back
