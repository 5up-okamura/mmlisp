; SE suspend/restore gate (plan-se.md). A BGM FM track holds a sustained note
; on fm1; an effect takes that channel mid-sustain, plays a short burst, then
; ends — and the BGM note must resume with its voice, level and pitch restored
; and re-keyed. The same on sqr1 (PSG) and on pcm1's voice (PCM, which has no
; owner to suspend: the effect overwrites the voice, and its end starts the
; BGM's loop again). The song and the effects are host-driven from
; m3-se.cmds.json with auto-start off.
;
; :vel < 15 on the BGM forces the carrier-TL attenuation path, so the restore
; must recompose the level (not just re-key) to match.
(def-score :pcm-voices 2)

(def-fm bgm :alg 7 :fb 0
  :ar1 31 :dr1 4 :sr1 1 :rr1 6 :sl1 2 :tl1 16 :ks1 0 :ml1 1 :dt1 0
  :ar2 31 :dr2 6 :sr2 1 :rr2 7 :sl2 2 :tl2 10 :ks2 0 :ml2 2 :dt2 0
  :ar3 31 :dr3 5 :sr3 1 :rr3 6 :sl3 2 :tl3 20 :ks3 0 :ml3 3 :dt3 0
  :ar4 31 :dr4 8 :sr4 2 :rr4 8 :sl4 3 :tl4 4 :ks4 0 :ml4 1 :dt4 0)

(def-fm sfx :alg 7 :fb 5
  :ar1 31 :dr1 2 :sr1 0 :rr1 4 :sl1 0 :tl1 8 :ks1 0 :ml1 4 :dt1 0
  :ar2 31 :dr2 3 :sr2 0 :rr2 5 :sl2 1 :tl2 6 :ks2 0 :ml2 7 :dt2 0
  :ar3 31 :dr3 2 :sr3 0 :rr3 4 :sl3 0 :tl3 10 :ks3 0 :ml3 2 :dt3 0
  :ar4 31 :dr4 4 :sr4 1 :rr4 6 :sl4 2 :tl4 4 :ks4 0 :ml4 1 :dt4 0)

(def-pcm pad :file "pad.wav" :loop-start 9ms :loop-end 36ms)
(def-pcm blip :file "blip.wav")

; track 0: fm1 holds three whole notes — a long sustain the effect takes.
(fm1 :tempo 120 bgm :oct 4 :len 1 :vel 12  c c c)
; track 1: sqr1 holds a sustained tone.
(sqr1 :oct 5 :len 1 :vel 11  e e e)
; track 2: pcm1 plays a sustain-looping sample.
(pcm1 pad :mode loop :oct 4 :len 1 :vel 12  c c c)

; effect 0 (track 3): an FM burst on fm1.
(def-se fm (fm1 sfx :oct 5 :len 8 :vel 15  g g))
; effect 1 (track 4): a PSG burst on sqr1, after the FM one has ended.
(def-se psg (sqr1 :oct 6 :len 8 :vel 15  b b))
; effect 2 (track 5): a blip over pcm1's looping voice.
(def-se pcm (pcm1 blip :oct 5 :len 8 :vel 15  c))
